#!/usr/bin/env python3
"""Start a supervised Rill X11 session, or the optional Xfce compatibility session."""
import argparse
import configparser
import shlex
import json
import os
from pathlib import Path
import shutil
import sys
import xml.etree.ElementTree as ET


def property_at(parent, name, kind, value=None):
    item = next((p for p in parent.findall('property') if p.get('name') == name), None)
    if item is None:
        item = ET.SubElement(parent, 'property', name=name)
    item.set('type', kind)
    if value is not None:
        item.set('value', str(value))
    return item


def default_panel(path):
    """A single top panel; an imported personal layout always takes precedence."""
    root = ET.Element('channel', name='xfce4-panel', version='1.0')
    property_at(root, 'configver', 'int', 2)
    panels = property_at(root, 'panels', 'array')
    ET.SubElement(panels, 'value', type='int', value='1')
    property_at(panels, 'dark-mode', 'bool', 'true')
    panel = property_at(panels, 'panel-1', 'empty')
    for name, kind, value in [('position', 'string', 'p=6;x=0;y=0'),
                              ('length', 'uint', 100), ('position-locked', 'bool', 'true'),
                              ('size', 'uint', 26), ('icon-size', 'uint', 16)]:
        property_at(panel, name, kind, value)
    ids = property_at(panel, 'plugin-ids', 'array')
    plugins = property_at(root, 'plugins', 'empty')
    for i, module in enumerate(('applicationsmenu', 'tasklist', 'separator', 'pager',
                                'systray', 'clock', 'actions'), 1):
        ET.SubElement(ids, 'value', type='int', value=str(i))
        plugin = property_at(plugins, f'plugin-{i}', 'string', module)
        if module == 'separator':
            property_at(plugin, 'expand', 'bool', 'true')
            property_at(plugin, 'style', 'uint', 0)
    path.parent.mkdir(parents=True, exist_ok=True)
    ET.ElementTree(root).write(path, encoding='utf-8', xml_declaration=True)


def prepare(env, binary):
    home = Path(env['HOME'])
    original = Path(env.get('XDG_CONFIG_HOME', home / '.config'))
    cache = Path(env.get('XDG_CACHE_HOME', home / '.cache'))
    if not original.is_absolute() or not cache.is_absolute():
        raise ValueError('XDG configuration and cache paths must be absolute')
    mode = env.get('RILL_SESSION', 'rill')
    if mode not in ('rill', 'xfce'):
        raise ValueError('RILL_SESSION must be rill or xfce')
    profile = original / 'rill' / ('session' if mode == 'xfce' else 'desktop')
    profile.mkdir(parents=True, exist_ok=True, mode=0o700)
    # Programs that use XDG_CONFIG_HOME directly need their existing defaults
    # in the session profile as well as the XDG_CONFIG_DIRS fallback.
    for name in ('user-dirs.dirs', 'user-dirs.locale', 'mimeapps.list',
                 'gtk-3.0', 'gtk-4.0', 'fontconfig'):
        source, target = original / name, profile / name
        if source.exists() and not target.exists():
            if source.is_dir():
                shutil.copytree(source, target)
            else:
                shutil.copy2(source, target)
    personal = profile / 'rill'
    personal.mkdir(exist_ok=True)
    for pattern in ('settings*', 'panel*', 'desktop-layout', 'wm-keys'):
        for source in (original / 'rill').glob(pattern):
            target = personal / source.name
            if source.is_file() and not target.exists():
                shutil.copy2(source, target)
    xfce = profile / 'xfce4'
    if not xfce.exists():
        source = original / 'xfce4'
        if source.is_dir():
            shutil.copytree(source, xfce)
        else:
            xfce.mkdir()
    panel = xfce / 'xfconf/xfce-perchannel-xml/xfce4-panel.xml'
    if not panel.exists():
        default_panel(panel)
    channel = xfce / 'xfconf' / 'xfce-perchannel-xml' / 'xfce4-session.xml'
    channel.parent.mkdir(parents=True, exist_ok=True)
    if channel.exists():
        tree = ET.parse(channel)
        root = tree.getroot()
    else:
        root = ET.Element('channel', name='xfce4-session', version='1.0')
        tree = ET.ElementTree(root)
    general = property_at(root, 'general', 'empty')
    property_at(general, 'FailsafeSessionName', 'string', 'Rill')
    property_at(general, 'SessionName', 'string', 'Rill')
    # Inherit login agents; do not let a nested session replace the user's agent.
    startup = property_at(root, 'startup', 'empty')
    for agent in ('gpg-agent', 'ssh-agent'):
        property_at(property_at(startup, agent, 'empty'), 'enabled', 'bool', 'false')
    sessions = property_at(root, 'sessions', 'empty')
    session = property_at(sessions, 'Rill', 'empty')
    session.clear()
    session.attrib.update(name='Rill', type='empty')
    property_at(session, 'IsFailsafe', 'bool', 'true')
    wm = env.get('RILL_WM', str(Path(binary).with_name('rill-wm')))
    commands = [(wm,), ('xfsettingsd',), ('xfce4-panel',),
                ('Thunar', '--daemon'), (binary, '--desktop', '--external-panel')]
    property_at(session, 'Count', 'int', len(commands))
    for i, command in enumerate(commands):
        item = property_at(session, f'Client{i}_Command', 'array')
        for arg in command:
            ET.SubElement(item, 'value', type='string', value=arg)
        property_at(session, f'Client{i}_Priority', 'int', 15 + i * 5)
        property_at(session, f'Client{i}_PerScreen', 'bool', 'false')
    temporary = channel.with_suffix('.tmp')
    tree.write(temporary, encoding='utf-8', xml_declaration=True)
    temporary.replace(channel)
    if mode == 'rill':
        # Applications commonly ignore XDG_CONFIG_DIRS for personal settings.
        # Reuse their existing profiles; keep desktop/autostart overrides private.
        for source in original.iterdir():
            if source.name in ('rill', 'autostart'):
                continue
            target = profile / source.name
            if not target.exists() and not target.is_symlink():
                target.symlink_to(source, target_is_directory=source.is_dir())
    result = dict(env)
    result.update(XDG_CONFIG_HOME=str(profile), XDG_CACHE_HOME=str(cache / 'rill-session'),
                  XDG_CONFIG_DIRS=str(original) + ':' + env.get('XDG_CONFIG_DIRS', '/etc/xdg'),
                  XDG_CURRENT_DESKTOP='XFCE' if mode == 'xfce' else 'Rill:XFCE',
                  RILL_SESSION=mode, XDG_SESSION_DESKTOP='rill',
                  XDG_SESSION_TYPE='x11', DESKTOP_SESSION='rill', GDK_BACKEND='x11')
    if mode == 'rill':
        prepare_services(result, binary, original)
    result.pop('SESSION_MANAGER', None)
    result.pop('WAYLAND_DISPLAY', None)
    result.pop('WAYLAND_SOCKET', None)
    return result



def executable(command, env):
    return shutil.which(command, path=env.get('PATH'))


def choose_service(candidates, env):
    for command in candidates:
        path = executable(command[0], env)
        if path:
            return [path, *command[1:]]
    return None


def disabled_programs(env):
    result = set()
    directories = [Path(env['XDG_CONFIG_HOME']), *map(Path, env.get('XDG_CONFIG_DIRS', '/etc/xdg').split(':'))]
    seen = set()
    hidden = set()
    for directory in directories:
        for entry in (directory / 'autostart').glob('*.desktop'):
            parser = configparser.ConfigParser(interpolation=None, strict=False)
            try:
                parser.read(entry)
                values = parser['Desktop Entry']
                if entry.name not in seen:
                    if values.get('Hidden', '').lower() == 'true':
                        hidden.add(entry.name)
                    seen.add(entry.name)
                if entry.name in hidden:
                    arguments = shlex.split(values.get('Exec', ''))
                    if arguments:
                        result.add(Path(arguments[0]).name)
            except (configparser.Error, KeyError, ValueError):
                continue
    return result


def service_commands(env, binary):
    services = [{'name': 'Window manager',
                 'command': [env.get('RILL_WM', str(Path(binary).with_name('rill-wm')))],
                 'restart': True, 'required': True},
                {'name': 'Panel', 'command': [binary, '--panel', 'primary'],
                 'restart': True, 'required': True}]
    # Existing service providers remain selectable. No Xfce program is a
    # prerequisite of the native session. Foreground commands allow supervision.
    if env.get('RILL_SESSION_SERVICES', 'auto') == 'none':
        return services
    providers = {
        'Settings': [['xfsettingsd', '--no-daemon']],
        'Power': [['xfce4-power-manager', '--no-daemon'],
                  ['mate-power-manager', '--no-daemon']],
        'Authentication': [['/usr/libexec/polkit-mate-authentication-agent-1'],
                           ['/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1'],
                           ['/usr/libexec/polkit-gnome-authentication-agent-1'], ['lxpolkit']],
        'Network': [['nm-applet']],
        'Bluetooth': [['blueman-applet']],
        'Removable media': [['udiskie', '--tray']],
        'Locker': [['xfce4-screensaver', '--no-daemon'],
                   ['mate-screensaver', '--no-daemon'], ['xscreensaver', '-no-splash']],
    }
    disabled = disabled_programs(env)
    for name, candidates in providers.items():
        command = choose_service([item for item in candidates if Path(item[0]).name not in disabled], env)
        if command:
            services.append({'name': name, 'command': command,
                             'restart': True, 'required': False})
    if not any(service['name'] == 'Locker' for service in services):
        if 'xss-lock' not in disabled and executable('xss-lock', env) and executable('i3lock', env):
            services.append({'name': 'Locker', 'command': [executable('xss-lock', env),
                             '--transfer-sleep-lock', '--', executable('i3lock', env), '--nofork'],
                             'restart': True, 'required': False})
    return services


def keyfile_string(value):
    return str(value).replace('\\', '\\\\').replace('\n', '\\n').replace('\r', '\\r').replace(';', '\\;')


def configured_services(env, binary, original):
    services = service_commands(env, binary)
    panels = original / 'rill' / 'panels.json'
    if panels.exists():
        entries = json.loads(panels.read_text())
        if not isinstance(entries, list) or not entries:
            raise ValueError('panels.json must contain at least one panel')
        services = [service for service in services if service['name'] != 'Panel']
        ids = set()
        for panel in entries:
            name = panel.get('id', '') if isinstance(panel, dict) else ''
            if not isinstance(name, str) or not name or len(name) > 63 or not all(c.isascii() and (c.isalnum() or c in '-_') for c in name) or name in ids:
                raise ValueError('each panel needs a unique id containing letters, digits, hyphens or underscores')
            ids.add(name)
            output = panel.get('output', '')
            if not isinstance(output, str) or '\0' in output or len(output) > 127:
                raise ValueError('panel output must be an XRandR output name')
            edge = panel.get('edge', 'top')
            if edge not in ('top', 'bottom', 'left', 'right'):
                raise ValueError('panel edge must be top, bottom, left or right')
            size = panel.get('size', 26)
            if not isinstance(size, int) or size < 20 or size > 64:
                raise ValueError('panel size must be between 20 and 64')
            autohide = panel.get('autohide', False)
            if not isinstance(autohide, bool):
                raise ValueError('panel autohide must be true or false')
            command = [binary, '--panel', name, '--panel-edge', edge,
                       '--panel-size', str(size), '--panel-autohide', '1' if autohide else '0']
            if output:
                command += ['--panel-output', output]
            services.append({'name': 'Panel ' + name, 'command': command, 'restart': True, 'required': True})
    configuration = original / 'rill' / 'services.json'
    if configuration.exists():
        overrides = json.loads(configuration.read_text())
        if not isinstance(overrides, list):
            raise ValueError('services.json must contain a list of services')
        for service in overrides:
            if not isinstance(service, dict) or not isinstance(service.get('name'), str):
                raise ValueError('each service must have a name')
            services = [item for item in services if item['name'] != service['name']]
            if service.get('enabled', True):
                command = service.get('command')
                if not isinstance(command, list) or not command or not all(
                        isinstance(arg, str) and '\0' not in arg for arg in command):
                    raise ValueError('service command must be a nonempty list of arguments')
                services.append(service)
    return services


def prepare_services(env, binary, original):
    services = configured_services(env, binary, original)
    path = Path(env['XDG_CONFIG_HOME']) / 'services.ini'
    lines = []
    for index, service in enumerate(services):
        lines.extend([f'[Service {index}]',
                      'Command=' + ';'.join(keyfile_string(arg) for arg in service['command']) + ';',
                      'Restart=' + str(bool(service.get('restart', True))).lower(),
                      'Required=' + str(bool(service.get('required', False))).lower(), ''])
    temporary = path.with_suffix('.tmp')
    temporary.write_text('\n'.join(lines))
    temporary.chmod(0o600)
    temporary.replace(path)
    env['RILL_SESSION_SERVICES_FILE'] = str(path)
    env['RILL_SESSION_PROVIDERS'] = ', '.join(service['name'] for service in services)
    env['RILL_SESSION_EXTERNAL_SETTINGS'] = '1' if any(service['name'] == 'Settings' for service in services) else '0'
    # Rill owns these facilities. Mask system autostarts in the private profile;
    # never overwrite an explicit user entry in that profile.
    autostart = Path(env['XDG_CONFIG_HOME']) / 'autostart'
    autostart.mkdir(exist_ok=True)
    for name in ('xfce4-panel.desktop', 'xfdesktop.desktop', 'xfce4-notifyd.desktop',
                 'xfce4-clipman-plugin-autostart.desktop'):
        target = autostart / name
        if not target.exists():
            target.write_text('[Desktop Entry]\nType=Application\nHidden=true\n')


def required_commands(env, binary):
    if env.get('RILL_SESSION', 'rill') == 'xfce':
        return ['dbus-run-session', 'xfce4-session',
                env.get('RILL_WM', str(Path(binary).with_name('rill-wm'))),
                'xfsettingsd', 'xfce4-panel', 'Thunar']
    return ['dbus-run-session', str(Path(binary).with_name('rill-sessiond')),
            env.get('RILL_WM', str(Path(binary).with_name('rill-wm')))]


def session_command(env, binary):
    if env.get('RILL_SESSION', 'rill') == 'xfce':
        return ['dbus-run-session', '--', 'xfce4-session']
    sessiond = str(Path(binary).with_name('rill-sessiond'))
    command = ['dbus-run-session', '--', sessiond, '--restart-body', '--services',
               env['RILL_SESSION_SERVICES_FILE'], '--state-file',
               str(Path(env['XDG_CACHE_HOME']) / 'saved-session.ini')]
    if env.get('RILL_RESTORE_SESSION') == '1':
        command.append('--restore')
    if env.get('RILL_NO_AUTOSTART') == '1':
        command.append('--no-default-autostart')
    command.append('--')
    if env.get('RILL_SESSION_BODY'):
        command.extend(['sh', '-c', env['RILL_SESSION_BODY']])
    else:
        command.extend([binary, '--desktop', '--external-panel'])
    return command

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--prepare', action='store_true', help='prepare the profile without starting a session')
    parser.add_argument('--check', action='store_true', help='report installed session components without starting them')
    parser.add_argument('--mode', choices=('rill', 'xfce'), help='session provider (default: rill)')
    args = parser.parse_args()
    selected_env = dict(os.environ)
    if args.mode:
        selected_env['RILL_SESSION'] = args.mode
    here = Path(__file__).resolve()
    binary = os.environ.get('RILL_BIN') or shutil.which('rill')
    if binary is None:
        candidates = list((here.parent.parent / 'build').glob('linux-*/rill'))
        binary = str(candidates[0]) if len(candidates) == 1 else None
    if binary is None or not os.access(binary, os.X_OK):
        parser.error('rill is not installed; build it or set RILL_BIN')
    if args.check:
        check_env = dict(selected_env)
        check_env.setdefault('XDG_CONFIG_HOME', str(Path(check_env['HOME']) / '.config'))
        check_env.setdefault('XDG_CONFIG_DIRS', '/etc/xdg')
        required = required_commands(check_env, str(Path(binary).resolve()))
        services = configured_services(check_env, str(Path(binary).resolve()), Path(check_env['XDG_CONFIG_HOME']))
        missing = [command for command in required if not executable(command, check_env)]
        print(json.dumps({'session': check_env.get('RILL_SESSION', 'rill'),
                          'missing_required': missing,
                          'detected_providers': services,
                          'locker_available': any(service['name'] == 'Locker' for service in services)
                                              or bool(check_env.get('RILL_LOCK_COMMAND'))}, indent=2))
        return 1 if missing else 0
    if not args.prepare:
        if not os.environ.get('DISPLAY') or os.environ.get('WAYLAND_DISPLAY'):
            parser.error('start this session on an X11 display')
        if os.environ.get('SESSION_MANAGER'):
            parser.error('a session manager is already active; use the login-screen Rill session')
        for command in required_commands(selected_env, str(Path(binary).resolve())):
            if shutil.which(command) is None:
                parser.error(f'missing required component: {command}')
    env = prepare(selected_env, str(Path(binary).resolve()))
    if 'PLAN9' not in env:
        for candidate in (here.parent.parent.parent / 'plan9port',
                          Path('/usr/local/plan9'), Path('/usr/lib/plan9')):
            if (candidate / 'bin/devdraw').is_file():
                env['PLAN9'] = str(candidate)
                break
    if 'DEVDRAW' not in env and 'PLAN9' in env:
        env['DEVDRAW'] = str(Path(env['PLAN9']) / 'bin/devdraw')
    if args.prepare:
        print(json.dumps({key: env[key] for key in ('XDG_CONFIG_HOME', 'XDG_CACHE_HOME', 'XDG_CONFIG_DIRS')}))
        return
    command = session_command(env, str(Path(binary).resolve()))
    os.execvpe(command[0], command, env)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, ET.ParseError) as error:
        sys.exit(f'rill-session: {error}')
