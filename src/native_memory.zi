// Native memory is needed for C-callable desktop service snapshots. Behavior
// and ownership remain in Ziran; these are ordinary libc bindings.
#scope_file
libc :: #system_library "libc";
Calloc :: (count: usize, size: usize) -> *void #foreign libc "calloc";
Realloc :: (memory: *void, size: usize) -> *void #foreign libc "realloc";
Free :: (memory: *void) #foreign libc "free";
Memmove :: (destination: *void, source: *void, size: usize) -> *void #foreign libc "memmove";
Memset :: (destination: *void, value: s32, size: usize) -> *void #foreign libc "memset";
Getenv :: (name: *s8) -> *s8 #foreign libc "getenv";

#scope_export
AllocateZeroed :: (count: usize, size: usize) -> *void { return Calloc(count, size) }
ResizeAllocation :: (memory: *void, size: usize) -> *void { return Realloc(memory, size) }
ReleaseAllocation :: (memory: *void) { Free(memory) }
MoveBytes :: (destination: *void, source: *void, size: usize) {
    Memmove(destination, source, size)
}
SetBytes :: (destination: *void, value: s32, size: usize) {
    Memset(destination, value, size)
}
EnvironmentValue :: (name: *s8) -> *s8 { return Getenv(name) }

TextDescriptor :: struct {
    data: *s8
    count: usize
}

TextBytes :: (value: string) -> *s8 {
    descriptor := cast(*TextDescriptor)(*value)
    return descriptor.data
}

TextLength :: (value: *s8) -> s32 {
    if value == null { return 0 }
    count: s32 = 0
    while value[count] != 0 { count += 1 }
    return count
}

// The C desktop ABI lends NUL-terminated buffers. Borrow the bytes for the
// duration of a native call without allocating or changing their contents.
CString :: (value: *s8) -> string {
    result: string = ""
    descriptor := cast(*TextDescriptor)(*result)
    descriptor.data = value
    descriptor.count = cast(usize)TextLength(value)
    return result
}

FormatInteger :: (output: *s8, capacity: s32, value: s32) -> s32 {
    if output == null || capacity < 2 { return 0 }
    digits: [16]s8
    magnitude: s64 = cast(s64)value
    negative := magnitude < 0
    if negative { magnitude = -magnitude }
    count: s32 = 0
    while true {
        digits[count] = cast(s8)(48 + magnitude % 10)
        count += 1
        magnitude /= 10
        if magnitude == 0 { break }
    }
    needed := count
    if negative { needed += 1 }
    if needed >= capacity { output[0] = 0; return 0 }
    used: s32 = 0
    if negative { output[used] = 45; used += 1 }
    while count > 0 {
        count -= 1
        output[used] = digits[count]
        used += 1
    }
    output[used] = 0
    return used
}

CopyText :: (destination: *s8, capacity: s32, source: *s8) -> s32 {
    if destination == null || capacity <= 0 { return 0 }
    index: s32 = 0
    if source != null {
        while index + 1 < capacity && source[index] != 0 {
            destination[index] = source[index]
            index += 1
        }
    }
    destination[index] = 0
    return index
}

TextEquals :: (left: *s8, right: *s8) -> bool {
    if left == null || right == null { return left == right }
    index: s32 = 0
    while left[index] == right[index] {
        if left[index] == 0 { return true }
        index += 1
    }
    return false
}

TextStartsWith :: (text: *s8, prefix: string) -> bool {
    if text == null { return false }
    index: s32 = 0
    while index < cast(s32)prefix.count {
        if text[index] == 0 || cast(u8)text[index] != prefix[index] {
            return false
        }
        index += 1
    }
    return true
}
