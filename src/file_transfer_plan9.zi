// Native transfers advance at most one 32 KiB block per desktop poll.
// A private sibling is published only after a complete, unchanged copy.
File :: #import "file_plan9";
Process :: #import "process_plan9";
Paths :: #import "path";
Trash :: #import "file_trash_plan9";
Staging :: #import "file_staging_plan9";
NativeFiles :: #import "native_files";
#import "std/byte_text_linux"
#import "platform_types"
#import "native_memory"

#scope_file
ItemLimit :: 256;
CopyItem :: struct { source: [1024]s8; target: [1024]s8; info: File.FileInfo; history: *History; }
CopyNode :: struct {
    source: [1024]s8
    info: File.FileInfo
    owned: File.FileInfo
    directory: File.FileHandle
    parent: s32
    created: bool
    removed: bool
    children_removed: bool
}
History :: struct {
    source: [1024]s8
    result: [1024]s8
    nodes: *CopyNode
    count: s32
    slots: *s32
    capacity: s32
    recovery: Trash.Entry
    backup: *History
}
CopyJob :: struct {
    items: [256]CopyItem
    directory: [1024]s8
    destination: [1024]s8
    destination_info: File.FileInfo
    target: [1024]s8
    staging: [1024]s8
    receipt: Staging.Receipt
    input: File.FileHandle
    output: File.FileHandle
    offset: s64
    buffer: [32768]u8
    status: FileTransferStatus
    index: s32
    phase: s32 // 0 target, 1 bytes, 2 plan, 3 nodes, 4 verify, 5 attributes, 6 publish, 7 move check, 8 remove, 9 archive destination, 10 undo
    sticky: s32 // 0 ask, 1 skip, 2 replace, 3 keep both
    nodes: *CopyNode
    node_count: s32
    node_capacity: s32
    plan_index: s32
    node_index: s32
    check_index: s32
    cursor: File.DirectoryCursor
    kind: s32 // 0 ordinary transfer, 1 trash, 2 restore, 3 empty, 4 undo
    trash_root: [1024]s8
    trash: Trash.Entry
    conflict_info: File.FileInfo
    replacing: bool
    replacement_done: bool
    replacement: *CopyJob
    published: bool
    retrying: bool
    record_history: bool
    suppress_history: bool
    history_failed: bool
    replacement_history: *History
    expected: *History
    exact_target: bool
    undo_child: *CopyJob
    undo_stage: s32 // 0 batch check, 1 result check, 2 reverse, 3 backup check, 4 restore
    undo_part: s32
    undo_move: bool
}
job: *CopyJob;
sequence: u32;
conflicts: bool;
history: [256]*History;
history_count: s32;
history_move: bool;

HistoryHash :: (path: string) -> u32 {
    value: u32 = cast(u32)2166136261
    index: s64 = 0
    while index < path.count { value = (value ^ cast(u32)path[index]) * cast(u32)16777619; index += 1 }
    return value
}

FreeHistory :: (record: *History) {
    if record == null { return }
    FreeHistory(record.backup)
    ReleaseAllocation(cast(*void)record.nodes)
    ReleaseAllocation(cast(*void)record.slots)
    ReleaseAllocation(cast(*void)record)
}

FreeJobHistory :: () {
    index: s32 = 0
    while index < job.status.total {
        FreeHistory(job.items[index].history)
        job.items[index].history = null
        index += 1
    }
    FreeHistory(job.replacement_history)
    job.replacement_history = null
}

ClearHistory :: () {
    index: s32 = 0
    while index < history_count { FreeHistory(history[index]); history[index] = null; index += 1 }
    history_count = 0
}

SaveHistory :: () -> *History {
    if job.node_count <= 0 || job.node_count > 1073741823 { return null }
    record := cast(*History)AllocateZeroed(1, size_of(History))
    if record == null { return null }
    record.capacity = 2
    while record.capacity < job.node_count * 2 {
        if record.capacity > 536870911 { ReleaseAllocation(cast(*void)record); return null }
        record.capacity *= 2
    }
    record.slots = cast(*s32)AllocateZeroed(cast(usize)record.capacity, size_of(s32))
    if record.slots == null { ReleaseAllocation(cast(*void)record); return null }
    CopyText(*record.source[0], 1024, *job.items[job.index].source[0])
    CopyText(*record.result[0], 1024, *job.target[0])
    record.nodes = job.nodes
    record.count = job.node_count
    root_length := TextLength(*record.source[0])
    index: s32 = 0
    while index < record.count {
        suffix := CString(*record.nodes[index].source[root_length])
        slot := cast(s32)(HistoryHash(suffix) & cast(u32)(record.capacity - 1))
        while record.slots[slot] != 0 { slot = (slot + 1) & (record.capacity - 1) }
        record.slots[slot] = index + 1
        index += 1
    }
    if job.kind == 1 {
        record.recovery = job.trash
        // The live transfer closes its fid; history owns only value metadata.
        record.recovery.directory.valid = false
        record.recovery.owned = null
        record.recovery.ledger = null
    }
    record.backup = job.replacement_history
    job.replacement_history = null
    job.nodes = null
    job.node_count = 0
    job.node_capacity = 0
    return record
}

PublishHistory :: () {
    if job.kind != 0 || job.suppress_history || job.status.completed == 0 { return }
    ClearHistory()
    if job.history_failed { FreeJobHistory(); return }
    history_move = TextEquals(*job.status.operation[0], TextBytes("move"))
    index := job.status.total
    while index > 0 {
        index -= 1
        record := job.items[index].history
        if record != null { history[history_count] = record; history_count += 1; job.items[index].history = null }
    }
}

HistoryFind :: (record: *History, suffix: string) -> s32 {
    if record == null || record.capacity <= 0 { return -1 }
    slot := cast(s32)(HistoryHash(suffix) & cast(u32)(record.capacity - 1))
    root_length := TextLength(*record.source[0])
    while record.slots[slot] != 0 {
        index := record.slots[slot] - 1
        if CString(*record.nodes[index].source[root_length]) == suffix { return index }
        slot = (slot + 1) & (record.capacity - 1)
    }
    return -1
}

Expected :: (source: *s8, info: File.FileInfo) -> bool {
    if job.expected == null { return true }
    root_length := TextLength(*job.items[job.index].source[0])
    index := HistoryFind(job.expected, CString(*source[root_length]))
    return index >= 0 && Same(job.expected.nodes[index].owned, info) && (index != 0 || Trash.Physical(CString(source), info))
}

Destructive :: () -> bool {
    return job.kind != 0 || TextEquals(*job.status.operation[0], TextBytes("move"))
}

Same :: (left: File.FileInfo, right: File.FileInfo) -> bool {
    return left.valid && right.valid && left.type == right.type && left.device == right.device &&
        left.identity == right.identity && left.version == right.version && left.identity_type == right.identity_type &&
        left.mode == right.mode && left.modified == right.modified && left.length == right.length
}

Directory :: (info: File.FileInfo) -> bool { return (info.mode & cast(u32)0x80000000) != 0 }

Supported :: (info: File.FileInfo) -> bool {
    // Mounted files have a server-provided length and do not expose devices
    // such as console, snarf, or process control streams as ordinary files.
    return info.valid && info.type == cast(u16)77 && info.length >= 0 && (info.mode & cast(u32)0x7ffffe00) == 0
}

Identity :: (left: File.FileInfo, right: File.FileInfo) -> bool {
    return left.valid && right.valid && left.type == right.type && left.device == right.device &&
        left.identity == right.identity && left.identity_type == right.identity_type
}

Join :: (directory: *s8, name: *s8, output: *s8) -> bool {
    length := TextLength(directory)
    extra: s32 = 1
    if length == 1 { extra = 0 }
    if length == 0 || name == null || name[0] == 0 || length + extra + TextLength(name) >= 1024 { return false }
    CopyText(output, 1024, directory)
    if extra != 0 { output[length] = 47; length += 1 }
    CopyText(*output[length], 1024 - length, name)
    return true
}

Base :: (path: *s8) -> *s8 {
    index: s32 = 0
    start: s32 = 0
    while path[index] != 0 { if path[index] == 47 { start = index + 1 }; index += 1 }
    return *path[start]
}

NodePath :: (index: s32, output: *s8) -> bool {
    root_length := TextLength(*job.items[job.index].source[0])
    suffix := *job.nodes[index].source[root_length]
    length := TextLength(*job.staging[0])
    if length == 0 || length + TextLength(suffix) >= 1024 { return false }
    CopyText(output, 1024, *job.staging[0])
    CopyText(*output[length], 1024 - length, suffix)
    return true
}

PublishedPath :: (index: s32, output: *s8) -> bool {
    root_length := TextLength(*job.items[job.index].source[0])
    suffix := *job.nodes[index].source[root_length]
    length := TextLength(*job.target[0])
    if length == 0 || length + TextLength(suffix) >= 1024 { return false }
    CopyText(output, 1024, *job.target[0])
    CopyText(*output[length], 1024 - length, suffix)
    return true
}

OwnedParents :: (index: s32) -> bool {
    parent := job.nodes[index].parent
    while parent >= 0 {
        path: [1024]s8
        if !job.nodes[parent].created || !NodePath(parent, *path[0]) ||
            !Identity(job.nodes[parent].owned, File.PathInfo(CString(*path[0]))) { return false }
        parent = job.nodes[parent].parent
    }
    return true
}

ClearNodes :: () {
    if job.cursor.valid { File.CloseDirectory(*job.cursor) }
    ReleaseAllocation(cast(*void)job.nodes)
    job.nodes = null
    job.node_count = 0
    job.node_capacity = 0
    job.plan_index = 0
    job.node_index = 0
    job.check_index = 0
}

DisposeReplacement :: () -> bool {
    if job.replacement == null { return true }
    parent := job
    child := parent.replacement
    parent.replacement = null
    job = child
    ok := Cleanup()
    Trash.Release(*child.trash)
    ClearNodes()
    FreeJobHistory()
    ReleaseAllocation(cast(*void)child)
    job = parent
    return ok
}

Cleanup :: () -> bool {
    // Keep a published replacement archive's snapshot for retry. It may
    // already have removed some of the old destination's source entries.
    ok := true
    if job.replacement != null {
        parent := job
        child := parent.replacement
        job = child
        child.status.running = 0
        ok = Cleanup()
        job = parent
    }
    if job.undo_child != null {
        parent := job
        child := parent.undo_child
        job = child
        if child.status.running != 0 {
            child.status.running = 0
            child.status.cancelled = 1
            CopyText(*child.status.error[0], 256, TextBytes("The file transfer was interrupted"))
        }
        if !Cleanup() { ok = false }
        job = parent
    }
    if job.cursor.valid { if !File.CloseDirectory(*job.cursor) { ok = false } }
    if job.input.valid { if !File.CloseFile(job.input) { ok = false }; job.input.valid = false }
    if job.output.valid { if !File.CloseFile(job.output) { ok = false }; job.output.valid = false }
    // Restore traversal rights from the top down using our retained fids.
    // Remove only recorded creations, never a recursive rescan of the stage.
    index: s32 = 0
    while index < job.node_count {
        node := *job.nodes[index]
        if node.directory.valid {
            path: [1024]s8
            if node.created && OwnedParents(index) && NodePath(index, *path[0]) &&
                Identity(node.owned, File.PathInfo(CString(*path[0]))) {
                if !File.SetFileAttributes(node.directory, cast(u32)448, node.owned.modified) { ok = false }
            } else if node.created { ok = false }
            if !File.CloseFile(node.directory) { ok = false }
            node.directory.valid = false
        }
        index += 1
    }
    index = job.node_count
    while index > 0 {
        index -= 1
        node := *job.nodes[index]
        if !node.created { continue }
        path: [1024]s8
        if OwnedParents(index) && NodePath(index, *path[0]) &&
            Identity(node.owned, File.PathInfo(CString(*path[0]))) && File.RemoveFile(CString(*path[0])) {
            node.created = false
        } else { ok = false }
    }
    if job.node_count == 0 || !job.nodes[0].created { job.staging[0] = 0 }
    if job.staging[0] == 0 && !Staging.Forget(*job.receipt) { ok = false }
    if job.kind == 1 && job.trash.reserved && !job.trash.published {
        if ok { if !Trash.Forget(*job.trash) { ok = false } }
        else { Trash.Close(*job.trash) }
    } else {
        if !Trash.Close(*job.trash) { ok = false }
        Trash.Release(*job.trash)
    }
    return ok
}

Fail :: (message: string) {
    cleaned := Cleanup()
    job.status.running = 0
    job.status.conflict = 0
    CopyText(*job.status.error[0], 256, TextBytes(message))
    if !cleaned { CopyText(*job.status.error[0], 256, TextBytes("The copy failed and some staging entries could not be removed")) }
}

UniqueTarget :: () -> bool {
    name := Base(*job.items[job.index].source[0])
    if job.kind == 2 || job.exact_target { name = Base(*job.items[job.index].target[0]) }
    split := TextLength(name)
    index: s32 = 1
    while name[index] != 0 { if name[index] == 46 && !Directory(job.items[job.index].info) { split = index }; index += 1 }
    attempt: s32 = 1
    while attempt <= 999 {
        candidate: [1024]s8
        if split + 32 + TextLength(*name[split]) >= 1024 { return false }
        index = 0
        while index < split { candidate[index] = name[index]; index += 1 }
        suffix := TextBytes(" (copy ")
        if job.kind == 2 || job.exact_target { suffix = TextBytes(" (restored ") }
        used := split + CopyText(*candidate[split], 1024 - split, suffix)
        used += FormatInteger(*candidate[used], 1024 - used, attempt)
        used += CopyText(*candidate[used], 1024 - used, TextBytes(")"))
        CopyText(*candidate[used], 1024 - used, *name[split])
        if !Join(*job.directory[0], *candidate[0], *job.target[0]) { return false }
        if !File.PathExists(CString(*job.target[0])) { return true }
        attempt += 1
    }
    return false
}

Next :: (skipped: bool) {
    if !Staging.Forget(*job.receipt) {
        Fail("The operation finished, but its staging receipt could not be removed"); return
    }
    if !skipped && (job.kind == 2 || job.kind == 3) && !Trash.Forget(*job.trash) {
        Fail("The operation finished, but the recovery record could not be removed"); return
    }
    if !skipped && ((job.kind == 0 && !job.suppress_history) || job.record_history) {
        job.items[job.index].history = SaveHistory()
        if job.items[job.index].history == null {
            job.history_failed = true
            FreeHistory(job.replacement_history)
            job.replacement_history = null
        }
    }
    Trash.Release(*job.trash)
    job.trash = .{}
    job.conflict_info = .{}
    job.replacing = false
    job.replacement_done = false
    job.published = false
    job.retrying = false
    ClearNodes()
    if skipped { job.status.skipped += 1 }
    else { job.status.completed += 1 }
    job.index += 1
    job.phase = 0
    job.status.conflict = 0
    job.status.conflict_destination[0] = 0
    if job.index >= job.status.total { job.status.running = 0; PublishHistory() }
}

OpenStaging :: () -> bool {
    attempt: s32 = 0
    while attempt < 32 {
        name: [96]s8
        used := CopyText(*name[0], 96, TextBytes(".transfer-"))
        used += FormatInteger(*name[used], 96 - used, Process.CurrentProcessId())
        used += CopyText(*name[used], 96 - used, TextBytes("-"))
        used += FormatInteger(*name[used], 96 - used, cast(s32)(job.status.id & cast(u32)2147483647))
        used += CopyText(*name[used], 96 - used, TextBytes("-"))
        used += FormatInteger(*name[used], 96 - used, job.index)
        used += CopyText(*name[used], 96 - used, TextBytes("-"))
        FormatInteger(*name[used], 96 - used, attempt)
        candidate: [1024]s8
        if !Join(*job.directory[0], *name[0], *candidate[0]) { return false }
        if !Staging.Available(*job.directory[0], *name[0]) { attempt += 1; continue }
        created: File.FileHandle
        directory := Directory(job.nodes[0].info)
        if directory { created = File.CreatePrivateDirectoryHandle(CString(*candidate[0])) }
        else { created = File.CreatePrivateExclusive(CString(*candidate[0]), false) }
        if created.valid {
            CopyText(*job.staging[0], 1024, *candidate[0])
            job.nodes[0].created = true
            job.nodes[0].owned = File.HandleInfo(created)
            if directory { job.nodes[0].directory = created } else { job.output = created }
            return job.nodes[0].owned.valid && Staging.Create(*job.directory[0], *name[0], Base(*job.target[0]),
                *job.items[job.index].source[0], job.nodes[0].owned, job.kind, *job.receipt)
        }
        attempt += 1
    }
    return false
}

AddNode :: (source: *s8, info: File.FileInfo, parent: s32) -> bool {
    if job.node_count == job.node_capacity {
        capacity: s32 = 32
        if job.node_capacity > 0 {
            if job.node_capacity > 1073741823 { return false }
            capacity = job.node_capacity * 2
        }
        if cast(usize)capacity > cast(usize)-1 / size_of(CopyNode) { return false }
        memory := cast(*CopyNode)ResizeAllocation(cast(*void)job.nodes, cast(usize)capacity * size_of(CopyNode))
        if memory == null { return false }
        job.nodes = memory
        job.node_capacity = capacity
    }
    node := *job.nodes[job.node_count]
    node.* = .{}
    CopyText(*node.source[0], 1024, source)
    node.info = info
    node.parent = parent
    job.node_count += 1
    return true
}

PlanStart :: () {
    item := *job.items[job.index]
    if !Expected(*item.source[0], item.info) { Fail("The completed transfer changed before it could be undone"); return }
    if (job.kind == 2 || job.kind == 3) && !Trash.Owns(*job.trash, "", item.info) {
        Fail("The payload is not owned by this Trash record"); return
    }
    if !Same(item.info, File.PathInfo(CString(*item.source[0]))) || !AddNode(*item.source[0], item.info, -1) {
        Fail("The source changed or its snapshot could not be allocated"); return
    }
    job.phase = 2
}

PlanStep :: () {
    if job.plan_index >= job.node_count {
        if job.expected != null && job.node_count != job.expected.count { Fail("The completed transfer's folder contents changed"); return }
        if job.kind == 3 { job.check_index = job.node_count; job.phase = 8; return }
        if !OpenStaging() { Fail("Could not create the private staging entry"); return }
        job.node_index = 0
        job.phase = 3
        return
    }
    node := *job.nodes[job.plan_index]
    if !Directory(node.info) { job.plan_index += 1; return }
    CopyText(*job.status.current[0], 1024, *node.source[0])
    if !job.cursor.valid {
        if !Same(node.info, File.PathInfo(CString(*node.source[0]))) { Fail("The source folder changed while planning the copy"); return }
        job.cursor = File.OpenDirectory(CString(*node.source[0]))
        if !job.cursor.valid { Fail("Could not list the complete source folder"); return }
    }
    entry := File.NextDirectoryEntry(*job.cursor)
    if !entry.valid {
        failed := job.cursor.failed
        File.CloseDirectory(*job.cursor)
        if failed || !Same(node.info, File.PathInfo(CString(*node.source[0]))) { Fail("The source folder changed or contains an invalid entry"); return }
        job.plan_index += 1
        return
    }
    source: [1024]s8
    if !Join(*node.source[0], cast(*s8)(*entry.name[0]), *source[0]) { Fail("A source path is too long"); return }
    info := File.PathInfo(CString(*source[0]))
    if !Supported(info) { Fail("The folder contains an unsupported file or device"); return }
    if !Expected(*source[0], info) { Fail("The completed transfer's folder contents changed"); return }
    if (job.kind != 0 || job.expected != null) && !Identity(entry.info, info) { Fail("The source entry changed during enumeration"); return }
    if job.kind == 2 || job.kind == 3 {
        root_length := TextLength(*job.items[job.index].source[0])
        if !Trash.Owns(*job.trash, CString(*source[root_length]), info) {
            Fail("A source entry is not owned by this Trash record"); return
        }
    }
    if Directory(info) {
        parent := job.plan_index
        while parent >= 0 {
            if Identity(info, job.nodes[parent].info) { Fail("A bound source folder refers to one of its ancestors"); return }
            parent = job.nodes[parent].parent
        }
    }
    // AddNode may resize storage; do not use the borrowed node afterward.
    if !AddNode(*source[0], info, job.plan_index) { Fail("Could not allocate the complete folder snapshot") }
}

BeginNode :: () {
    if job.node_index >= job.node_count { job.check_index = 0; job.phase = 4; return }
    node := *job.nodes[job.node_index]
    CopyText(*job.status.current[0], 1024, *node.source[0])
    if !Same(node.info, File.PathInfo(CString(*node.source[0]))) { Fail("A source entry changed before it could be copied"); return }
    target: [1024]s8
    if !NodePath(job.node_index, *target[0]) { Fail("A destination path is too long"); return }
    if Directory(node.info) {
        if !node.created {
            node.directory = File.CreatePrivateDirectoryHandle(CString(*target[0]))
            if !node.directory.valid { Fail("Could not create a private staging folder"); return }
            node.created = true
            node.owned = File.HandleInfo(node.directory)
            if !node.owned.valid { Fail("Could not identify the staging folder"); return }
        }
        job.node_index += 1
        return
    }
    job.input = File.OpenRead(CString(*node.source[0]))
    if !Same(node.info, File.HandleInfo(job.input)) { Fail("The source changed before it could be copied"); return }
    if !node.created {
        job.output = File.CreatePrivateExclusive(CString(*target[0]), false)
        if !job.output.valid { Fail("Could not create a private staging file"); return }
        node.created = true
        node.owned = File.HandleInfo(job.output)
        if !node.owned.valid { Fail("Could not identify the staging file"); return }
    }
    job.offset = 0
    job.phase = 1
}

BeginItem :: () {
    item := *job.items[job.index]
    CopyText(*job.status.current[0], 1024, *item.source[0])
    if job.kind == 1 {
        if !Trash.Reserve(*job.trash_root[0], *item.source[0], job.status.id, job.index, Process.CurrentProcessId(), *job.trash) {
            Fail("Could not reserve a private Trash entry"); return
        }
        CopyText(*job.directory[0], 1024, *job.trash.path[0])
        CopyText(*job.target[0], 1024, *job.trash.data[0])
        PlanStart(); return
    }
    if job.kind == 3 { PlanStart(); return }
    if job.kind == 2 || job.exact_target { CopyText(*job.target[0], 1024, *item.target[0]) }
    else if !Join(*job.directory[0], Base(*item.source[0]), *job.target[0]) { Fail("The destination name is too long"); return }
    duplicate := TextEquals(*job.status.operation[0], TextBytes("duplicate"))
    if duplicate {
        if !UniqueTarget() { Fail("Could not find an unused copy name"); return }
    } else if File.PathExists(CString(*job.target[0])) {
        if job.kind == 2 || job.exact_target {
            if !UniqueTarget() { Fail("Could not find an unused restored name"); return }
            PlanStart(); return
        }
        job.conflict_info = File.PathInfo(CString(*job.target[0]))
        if job.sticky == 1 { Next(true); return }
        if job.sticky == 2 {
            if !CanReplace() { Fail("The destination changed, is unsupported, or overlaps a selected source"); return }
            job.replacing = true
            PlanStart(); return
        }
        if job.sticky == 3 {
            if !UniqueTarget() { Fail("Could not find an unused copy name"); return }
        } else if conflicts {
            job.status.conflict = 1
            CopyText(*job.status.conflict_destination[0], 512, *job.target[0])
            return
        } else { Fail("The destination already exists"); return }
    }
    PlanStart()
}

CopyBlock :: () {
    item := *job.nodes[job.node_index]
    remaining := item.info.length - job.offset
    if remaining > 0 {
        count := remaining
        if count > 32768 { count = 32768 }
        read := File.ReadAt(job.input, job.buffer[0:count], job.offset)
        if read <= 0 || read > count { Fail("Could not read the complete source file"); return }
        written: s64 = 0
        while written < read {
            amount := File.WriteAt(job.output, job.buffer[written:read], job.offset + written)
            if amount <= 0 || amount > read - written { Fail("Could not write the complete copy"); return }
            written += amount
        }
        job.offset += read
        job.status.bytes += cast(u64)read
        return
    }
    if !Same(item.info, File.HandleInfo(job.input)) || !Same(item.info, File.PathInfo(CString(*item.source[0]))) {
        Fail("The source changed during the copy"); return
    }
    if !File.SetFileAttributes(job.output, item.info.mode & cast(u32)511, item.info.modified) {
        Fail("Could not preserve the file attributes"); return
    }
    item.owned = File.HandleInfo(job.output)
    if !item.owned.valid { Fail("Could not verify the complete staging file"); return }
    input_closed := File.CloseFile(job.input)
    job.input.valid = false
    output_closed := File.CloseFile(job.output)
    job.output.valid = false
    if !input_closed || !output_closed { Fail("Could not close the complete copy"); return }
    job.node_index += 1
    job.phase = 3
}

VerifyStep :: () {
    if job.check_index >= job.node_count {
        job.check_index = job.node_count
        job.phase = 5
        return
    }
    node := *job.nodes[job.check_index]
    if !Same(node.info, File.PathInfo(CString(*node.source[0]))) { Fail("The source tree changed before publication"); return }
    job.check_index += 1
}

AttributeStep :: () {
    if job.check_index == 0 { job.phase = 6; return }
    job.check_index -= 1
    node := *job.nodes[job.check_index]
    if Directory(node.info) && !File.SetFileAttributes(node.directory, node.info.mode & cast(u32)511, node.info.modified) {
        Fail("Could not preserve the folder attributes"); return
    }
    if Directory(node.info) {
        node.owned = File.HandleInfo(node.directory)
        if !node.owned.valid { Fail("Could not verify the complete staging folder") }
    }
}

RecordTrash :: () -> bool {
    root_length := TextLength(*job.items[job.index].source[0])
    count: s64 = 0
    index: s32 = 0
    while index < job.node_count {
        count += 17 + TextLength(*job.nodes[index].source[root_length])
        if count > 67108864 - 1080 { return false }
        index += 1
    }
    memory := cast(*u8)AllocateZeroed(1, cast(usize)count)
    if memory == null { return false }
    bytes := BytesFromPointer(memory, cast(u64)count)
    offset: s64 = 0
    index = 0
    while index < job.node_count {
        node := *job.nodes[index]
        if node.owned.type != job.trash.directory_info.type || node.owned.device != job.trash.directory_info.device {
            offset = -1; break
        }
        offset = Trash.NodeRecord(bytes, offset, CString(*node.source[root_length]), node.owned)
        if offset < 0 { break }
        index += 1
    }
    ok := offset == count && Trash.Record(*job.trash, job.nodes[0].owned, bytes, job.node_count)
    ReleaseAllocation(cast(*void)memory)
    return ok
}

Publish :: () {
    // Verify again after attribute writes; no planned source is removed.
    index: s32 = 0
    while index < job.node_count {
        node := *job.nodes[index]
        if !Same(node.info, File.PathInfo(CString(*node.source[0]))) { Fail("The source tree changed before publication"); return }
        path: [1024]s8
        if !NodePath(index, *path[0]) || !Same(node.owned, File.PathInfo(CString(*path[0]))) {
            Fail("A staging entry changed before publication"); return
        }
        index += 1
    }
    if job.kind == 1 && !RecordTrash() {
        Fail("Could not save the recovery record before publication"); return
    }
    if job.replacing && !job.replacement_done { BeginReplacement(); return }
    if job.kind != 0 && !Trash.Valid(*job.trash) { Fail("The Trash recovery record changed before publication"); return }
    if !File.RenameNoReplace(CString(*job.staging[0]), CString(*job.target[0])) { Fail("The copy could not be published without replacing another entry"); return }
    job.published = true
    if job.kind == 1 { job.trash.published = true }
    job.staging[0] = 0
    // Retain the post-rename root snapshot even if closing a descriptor or
    // removing a source later fails. Retry must verify this complete copy.
    current := File.PathInfo(CString(*job.target[0]))
    valid := Identity(job.nodes[0].owned, current) && current.mode == job.nodes[0].info.mode &&
        current.length == job.nodes[0].owned.length && current.modified == job.nodes[0].info.modified
    if valid { job.nodes[0].owned = current }
    index = 0
    while index < job.node_count {
        node := *job.nodes[index]
        node.created = false
        if node.directory.valid {
            if !File.CloseFile(node.directory) { CopyText(*job.status.error[0], 256, TextBytes("The copy was published but a folder descriptor could not be closed")) }
            node.directory.valid = false
        }
        index += 1
    }
    if !Staging.Forget(*job.receipt) {
        CopyText(*job.status.error[0], 256, TextBytes("The copy was published but its staging receipt could not be removed"))
    }
    if job.status.error[0] != 0 { job.status.running = 0; return }
    if !valid { Fail("The copy is complete, but the destination changed before the source could be moved"); return }
    if Destructive() {
        job.check_index = 0
        job.phase = 7
    } else { Next(false) }
}

MoveCheck :: () {
    if job.kind != 0 && !Trash.Valid(*job.trash) { Fail("The copy is complete, but the recovery record changed"); return }
    if job.check_index >= job.node_count {
        if !Destructive() { Next(false); return }
        job.check_index = job.node_count; job.phase = 8; return
    }
    node := *job.nodes[job.check_index]
    if Destructive() {
        current := File.PathInfo(CString(*node.source[0]))
        unchanged := Same(node.info, current)
        if Directory(node.info) && job.retrying && Identity(node.info, current) && Supported(current) {
            // Permission repair is allowed for surviving folders. Child
            // snapshots still match, and remove refuses unknown contents.
            node.info.mode = current.mode
            unchanged = true
        } else if Directory(node.info) && node.children_removed { unchanged = Identity(node.info, current) && node.info.mode == current.mode }
        if node.removed { unchanged = !File.PathExists(CString(*node.source[0])) }
        if !unchanged { Fail("The copy is complete, but the source changed before it could be moved"); return }
    }
    path: [1024]s8
    if job.kind != 3 && (!PublishedPath(job.check_index, *path[0]) || !Same(node.owned, File.PathInfo(CString(*path[0])))) {
        Fail("The copy is complete, but the destination changed before the source could be moved"); return
    }
    job.check_index += 1
}

SourceParents :: (index: s32) -> bool {
    parent := job.nodes[index].parent
    while parent >= 0 {
        node := *job.nodes[parent]
        current := File.PathInfo(CString(*node.source[0]))
        if !Identity(node.info, current) || node.info.mode != current.mode { return false }
        parent = node.parent
    }
    return true
}

PublishedParents :: (index: s32) -> bool {
    parent := job.nodes[index].parent
    while parent >= 0 {
        path: [1024]s8
        if !PublishedPath(parent, *path[0]) || !Same(job.nodes[parent].owned, File.PathInfo(CString(*path[0]))) { return false }
        parent = job.nodes[parent].parent
    }
    return true
}

RemoveSource :: () {
    if job.check_index == 0 { Next(false); return }
    if job.kind != 0 && !Trash.Valid(*job.trash) { Fail("The recovery record changed before source removal"); return }
    index := job.check_index - 1
    node := *job.nodes[index]
    if node.removed { job.check_index -= 1; return }
    CopyText(*job.status.current[0], 1024, *node.source[0])
    current := File.PathInfo(CString(*node.source[0]))
    unchanged := Same(node.info, current)
    if Directory(node.info) {
        // Our own child removals change directory versions and timestamps.
        // An unplanned child makes remove fail rather than being deleted.
        unchanged = Identity(node.info, current) && node.info.mode == current.mode
    }
    path: [1024]s8
    if job.kind != 3 && (!PublishedPath(index, *path[0]) || !PublishedParents(index) ||
        !Same(node.owned, File.PathInfo(CString(*path[0])))) {
        Fail("The copy is complete, but the destination changed before the source could be removed"); return
    }
    if !SourceParents(index) || !unchanged || !File.RemoveFile(CString(*node.source[0])) {
        Fail("The copy is complete, but a changed or protected source could not be removed"); return
    }
    node.removed = true
    if node.parent >= 0 { job.nodes[node.parent].children_removed = true }
    job.check_index -= 1
}

InsideSource :: (source: string, info: File.FileInfo, destination: string) -> bool {
    if Paths.WithinDirectory(destination, source) { return true }
    path: [1024]s8
    CopyText(*path[0], 1024, TextBytes(destination))
    used := TextLength(*path[0])
    while true {
        if Identity(info, File.PathInfo(CString(*path[0]))) { return true }
        if used <= 1 { return false }
        while used > 1 && path[used - 1] != 47 { used -= 1 }
        if used > 1 { used -= 1 }
        path[used] = 0
    }
}

CanReplace :: () -> bool {
    if job.kind != 0 || !Supported(job.conflict_info) ||
        !Same(job.conflict_info, File.PathInfo(CString(*job.target[0]))) { return false }
    target := CString(*job.target[0])
    index: s32 = 0
    while index < job.status.total {
        item := *job.items[index]
        source := CString(*item.source[0])
        if Identity(job.conflict_info, item.info) ||
            (Directory(job.conflict_info) && InsideSource(target, job.conflict_info, source)) ||
            (Directory(item.info) && InsideSource(source, item.info, target)) { return false }
        index += 1
    }
    return true
}

Prepare :: (operation: *s8, sources: **s8, count: s32, destination: *s8, recovery: *Trash.Entry, kind: s32) -> *CopyJob {
    if sources == null || count <= 0 || count > ItemLimit ||
        destination == null || (!TextEquals(operation, TextBytes("copy")) && !TextEquals(operation, TextBytes("duplicate")) &&
        !TextEquals(operation, TextBytes("move")) && !TextEquals(operation, TextBytes("trash")) && kind == 0) { return null }
    next := cast(*CopyJob)AllocateZeroed(1, size_of(CopyJob))
    if next == null { return null }
    next.kind = kind
    if recovery != null { next.trash = recovery.* }
    directory: [1024]u8
    canonical := Paths.CleanAbsolute(CString(destination), directory[:])
    ok := canonical.count > 0 && File.DirectoryExists(canonical)
    if ok {
        CopyText(*next.directory[0], 1024, cast(*s8)(*directory[0]))
        CopyText(*next.destination[0], 1024, *next.directory[0])
        next.destination_info = File.PathInfo(canonical)
    }
    if kind == 1 { CopyText(*next.trash_root[0], 1024, *next.directory[0]) }
    index: s32 = 0
    while ok && index < count {
        source: [1024]u8
        value := Paths.CleanAbsolute(CString(sources[index]), source[:])
        if value.count <= 1 { ok = false; break }
        if kind == 1 && Paths.WithinDirectory(value, canonical) { ok = false; break }
        info := File.PathInfo(value)
        if (kind == 2 || kind == 3) && (recovery == null || !Trash.Valid(recovery) || !Trash.Identity(info, recovery.data_info)) {
            ok = false; break
        }
        if !Supported(info) || (kind != 3 && Directory(info) && InsideSource(value, info, canonical)) ||
            (kind != 0 && !Trash.Physical(value, info)) { ok = false; break }
        CopyText(*next.items[index].source[0], 1024, cast(*s8)(*source[0]))
        next.items[index].info = info
        if kind != 0 || TextEquals(operation, TextBytes("move")) {
            previous: s32 = 0
            while previous < index {
                item := *next.items[previous]
                if Identity(info, item.info) ||
                    (Directory(item.info) && InsideSource(CString(*item.source[0]), item.info, value)) ||
                    (Directory(info) && InsideSource(value, info, CString(*item.source[0]))) { ok = false; break }
                previous += 1
            }
        }
        index += 1
    }
    if !ok { ReleaseAllocation(cast(*void)next); return null }
    sequence += 1
    if sequence == 0 { sequence = 1 }
    next.status.id = sequence
    next.status.running = 1
    next.status.total = count
    CopyText(*next.status.operation[0], 16, operation)
    return next
}

Start :: (operation: *s8, sources: **s8, count: s32, destination: *s8, recovery: *Trash.Entry, kind: s32) -> s32 {
    if job != null && job.status.running != 0 { return 0 }
    next := Prepare(operation, sources, count, destination, recovery, kind)
    if next == null { return 0 }
    if job != null {
        if !Cleanup() { ReleaseAllocation(cast(*void)next); return 0 }
        if !DisposeReplacement() { ReleaseAllocation(cast(*void)next); return 0 }
        if !DisposeUndoChild() { ReleaseAllocation(cast(*void)next); return 0 }
        ClearNodes()
        FreeJobHistory()
        ReleaseAllocation(cast(*void)job)
    }
    job = next
    return 1
}

BeginReplacement :: () {
    if job.replacement != null {
        parent := job
        job = parent.replacement
        ResumePublished()
        job = parent
        parent.phase = 9
        return
    }
    if !CanReplace() { Fail("The destination changed, is unsupported, or overlaps a selected source"); return }
    root: [1024]s8
    source: [1]*s8
    source[0] = *job.target[0]
    if !Trash.Root(*root[0], true) { Fail("The old destination could not be preserved in Trash"); return }
    child := Prepare(TextBytes("trash"), *source[0], 1, *root[0], null, 1)
    if child == null { Fail("The old destination could not be preserved in Trash"); return }
    if !Same(job.conflict_info, child.items[0].info) {
        ReleaseAllocation(cast(*void)child)
        Fail("The destination changed before it could be preserved in Trash"); return
    }
    job.replacement = child
    child.record_history = true
    job.phase = 9
}

ArchiveStep :: () {
    parent := job
    child := parent.replacement
    if child == null { Fail("The destination recovery operation is missing"); return }
    before := child.status.bytes
    job = child
    Advance()
    job = parent
    parent.status.bytes += child.status.bytes - before
    CopyText(*parent.status.current[0], 1024, *child.status.current[0])
    if child.status.running != 0 { return }
    ok := child.status.error[0] == 0 && child.status.completed == 1
    error: [256]s8
    CopyText(*error[0], 256, *child.status.error[0])
    if !ok {
        if error[0] == 0 { CopyText(*error[0], 256, TextBytes("The old destination could not be preserved in Trash")) }
        Fail(CString(*error[0])); return
    }
    parent.replacement_history = child.items[0].history
    child.items[0].history = null
    if parent.replacement_history == null { parent.history_failed = true }
    cleaned := DisposeReplacement()
    if !cleaned { Fail("The old destination is in Trash, but its transfer could not be closed"); return }
    parent.replacement_done = true
    parent.phase = 6
}

DisposeUndoChild :: () -> bool {
    if job.undo_child == null { return true }
    parent := job
    child := parent.undo_child
    parent.undo_child = null
    job = child
    ok := Cleanup()
    if !DisposeReplacement() { ok = false }
    Trash.Release(*child.trash)
    ClearNodes()
    FreeJobHistory()
    ReleaseAllocation(cast(*void)child)
    job = parent
    return ok
}

ParentPath :: (value: *s8, output: *s8) -> bool {
    CopyText(output, 1024, value)
    split := TextLength(output)
    while split > 0 && output[split - 1] != 47 { split -= 1 }
    if split == 0 { return false }
    if split > 1 { output[split - 1] = 0 } else { output[1] = 0 }
    return true
}

HistoryPath :: (record: *History, index: s32, output: *s8) -> bool {
    root_length := TextLength(*record.source[0])
    suffix := *record.nodes[index].source[root_length]
    used := CopyText(output, 1024, *record.result[0])
    if used + TextLength(suffix) >= 1024 { return false }
    CopyText(*output[used], 1024 - used, suffix)
    return true
}

UndoCheck :: (record: *History) -> bool {
    if record == null || record.count <= 0 { Fail("The Undo snapshot is missing"); return false }
    if record.recovery.recorded && !Trash.Valid(*record.recovery) { Fail("The replacement's Trash record changed"); return false }
    if job.check_index >= record.count { return true }
    path: [1024]s8
    if !HistoryPath(record, job.check_index, *path[0]) { Fail("An Undo path is too long"); return false }
    CopyText(*job.status.current[0], 1024, *path[0])
    current := File.PathInfo(CString(*path[0]))
    if !Same(record.nodes[job.check_index].owned, current) || (job.check_index == 0 && !Trash.Physical(CString(*path[0]), current)) {
        Fail("A completed transfer or its replacement backup changed"); return false
    }
    job.check_index += 1
    return false
}

UndoReverse :: (record: *History) {
    directory: [1024]s8
    source: [1]*s8
    source[0] = *record.result[0]
    operation := TextBytes("trash")
    kind: s32 = 1
    if job.undo_move {
        operation = TextBytes("move")
        kind = 0
        if !ParentPath(*record.source[0], *directory[0]) || !NativeFiles.EnsureDirectory(*directory[0]) {
            Fail("The original directory could not be recreated"); return
        }
    } else if !Trash.Root(*directory[0], true) { Fail("The copied result could not be preserved in Trash"); return }
    child := Prepare(operation, *source[0], 1, *directory[0], null, kind)
    if child == null { Fail("The completed result could not be undone"); return }
    child.expected = record
    child.suppress_history = true
    if job.undo_move { child.exact_target = true; CopyText(*child.items[0].target[0], 1024, *record.source[0]) }
    job.undo_child = child
    job.undo_stage = 2
}

UndoRestore :: (record: *History) {
    backup := record.backup
    root: [1024]s8
    directory: [1024]s8
    entry := cast(*Trash.Entry)AllocateZeroed(1, size_of(Trash.Entry))
    ok := entry != null && ParentPath(*backup.recovery.path[0], *root[0]) &&
        Trash.Read(*root[0], *backup.recovery.name[0], entry) &&
        Same(backup.recovery.record_info, entry.record_info) && Trash.Load(entry) &&
        ParentPath(*record.result[0], *directory[0]) && NativeFiles.EnsureDirectory(*directory[0])
    source: [1]*s8
    child: *CopyJob = null
    if ok {
        source[0] = *entry.data[0]
        child = Prepare(TextBytes("restore"), *source[0], 1, *directory[0], entry, 2)
    }
    if child == null {
        if entry != null { Trash.Release(entry) }
        ReleaseAllocation(cast(*void)entry)
        Fail("The replacement backup could not be restored"); return
    }
    // Prepare transferred the ledger to the child; the saved snapshot owns
    // no live handles or recovery allocations.
    ReleaseAllocation(cast(*void)entry)
    child.expected = backup
    child.suppress_history = true
    CopyText(*child.items[0].target[0], 1024, *record.result[0])
    job.undo_child = child
    job.undo_stage = 4
}

UndoComplete :: () {
    FreeHistory(job.items[job.index].history)
    job.items[job.index].history = null
    job.status.completed += 1
    job.index += 1
    job.check_index = 0
    job.undo_stage = 1
    if job.index >= job.status.total { job.status.running = 0 }
}

UndoChildStep :: () {
    parent := job
    child := parent.undo_child
    if child == null { Fail("The Undo operation is missing"); return }
    before := child.status.bytes
    job = child
    Advance()
    job = parent
    parent.status.bytes += child.status.bytes - before
    CopyText(*parent.status.current[0], 1024, *child.status.current[0])
    if child.status.running != 0 { return }
    if child.status.error[0] != 0 || child.status.completed != 1 {
        message: [256]s8
        CopyText(*message[0], 256, *child.status.error[0])
        if message[0] == 0 { CopyText(*message[0], 256, TextBytes("The Undo operation did not finish")) }
        Fail(CString(*message[0])); return
    }
    if !DisposeUndoChild() { Fail("The Undo transfer could not be closed"); return }
    if parent.undo_stage == 2 && parent.items[parent.index].history.backup != null {
        parent.undo_stage = 3
        parent.check_index = 0
    } else { UndoComplete() }
}

UndoStep :: () {
    if job.undo_stage == 0 {
        if job.plan_index >= job.status.total { job.undo_stage = 1; job.check_index = 0; return }
        record := job.items[job.plan_index].history
        if job.undo_part == 0 {
            if !UndoCheck(record) { return }
            job.undo_part = 1
        } else {
            if record.backup != null && !UndoCheck(record.backup) { return }
            job.undo_part = 0
            job.plan_index += 1
        }
        job.check_index = 0
    } else if job.undo_stage == 1 {
        record := job.items[job.index].history
        if UndoCheck(record) { UndoReverse(record); job.check_index = 0 }
    } else if job.undo_stage == 3 {
        record := job.items[job.index].history
        if UndoCheck(record.backup) { UndoRestore(record); job.check_index = 0 }
    } else { UndoChildStep() }
}

UndoRetry :: () -> s32 {
    if job.undo_child != null {
        parent := job
        job = parent.undo_child
        result := NativeCopyRetry()
        job = parent
        if result == 0 { return 0 }
    } else {
        job.check_index = 0
        job.undo_part = 0
        if job.undo_stage == 0 { job.plan_index = job.index }
    }
    job.status.running = 1
    job.status.cancelled = 0
    job.status.error[0] = 0
    return 1
}

Advance :: () {
    if job.status.running == 0 || job.status.conflict != 0 { return }
    if job.phase == 0 { BeginItem() }
    else if job.phase == 1 { CopyBlock() }
    else if job.phase == 2 { PlanStep() }
    else if job.phase == 3 { BeginNode() }
    else if job.phase == 4 { VerifyStep() }
    else if job.phase == 5 { AttributeStep() }
    else if job.phase == 6 { Publish() }
    else if job.phase == 7 { MoveCheck() }
    else if job.phase == 8 { RemoveSource() }
    else if job.phase == 9 { ArchiveStep() }
    else if job.phase == 10 { UndoStep() }
    if job.status.running != 0 && job.staging[0] != 0 && job.node_count > 0 {
        data := job.nodes[0].owned
        if job.nodes[0].directory.valid { data = File.HandleInfo(job.nodes[0].directory) }
        else if job.output.valid { data = File.HandleInfo(job.output) }
        if !Staging.Checkpoint(*job.receipt, data) { Fail("Could not checkpoint the partial copy's recovery receipt") }
    }
}

#scope_export
NativeRecoverStaging :: (directory: *s8, error: *s8, capacity: s32) -> s32 {
    if job != null && job.status.running != 0 {
        CopyText(error, capacity, TextBytes("Another file operation is still running")); return -1
    }
    return Staging.Recover(directory, error, capacity)
}

NativeCopyStart :: (operation: *s8, sources: **s8, count: s32, destination: *s8) -> s32 {
    if !TextEquals(operation, TextBytes("trash")) { return Start(operation, sources, count, destination, null, 0) }
    root: [1024]s8
    if !Trash.Root(*root[0], true) { return 0 }
    return Start(operation, sources, count, *root[0], null, 1)
}

NativeCopyPoll :: (status: *FileTransferStatus) -> s32 {
    if job == null || status == null { return 0 }
    Advance()
    status.* = job.status
    return 1
}

NativeCopyCancel :: () {
    if job == null || job.status.running == 0 { return }
    job.status.cancelled = 1
    Fail("The file transfer was cancelled")
}

NativeCopyFinish :: () {
    if job == null { return }
    Cleanup()
    DisposeReplacement()
    DisposeUndoChild()
    Trash.Release(*job.trash)
    ClearNodes()
    FreeJobHistory()
    ReleaseAllocation(cast(*void)job)
    job = null
    ClearHistory()
}

NativeCopyConflicts :: () -> s32 { conflicts = true; return 1 }

NativeCopyUndo :: () -> s32 {
    if history_count <= 0 || (job != null && job.status.running != 0) { return 0 }
    next := cast(*CopyJob)AllocateZeroed(1, size_of(CopyJob))
    if next == null { return 0 }
    if job != null {
        if !Cleanup() || !DisposeReplacement() || !DisposeUndoChild() { ReleaseAllocation(cast(*void)next); return 0 }
        ClearNodes()
        FreeJobHistory()
        ReleaseAllocation(cast(*void)job)
    }
    next.kind = 4
    next.phase = 10
    next.undo_move = history_move
    sequence += 1
    if sequence == 0 { sequence = 1 }
    next.status.id = sequence
    next.status.running = 1
    next.status.total = history_count
    CopyText(*next.status.operation[0], 16, TextBytes("undo"))
    index: s32 = 0
    while index < history_count { next.items[index].history = history[index]; history[index] = null; index += 1 }
    history_count = 0
    job = next
    return 1
}

#scope_file
ResumePublished :: () {
    job.status.running = 1
    job.status.cancelled = 0
    job.status.conflict = 0
    job.status.error[0] = 0
    job.status.conflict_destination[0] = 0
    job.check_index = 0
    job.phase = 7
    job.retrying = true
}

#scope_export
NativeCopyRetry :: () -> s32 {
    if job == null || job.status.running != 0 || job.status.error[0] == 0 || job.index >= job.status.total { return 0 }
    // A failed cleanup may leave a foreign entry in the private stage. Do
    // not discard the ownership snapshot or start another copy over it.
    if !Cleanup() { return 0 }
    if job.kind == 4 { return UndoRetry() }
    if !Identity(job.destination_info, File.PathInfo(CString(*job.destination[0]))) { return 0 }
    if job.kind == 2 || job.kind == 3 {
        if !Trash.Load(*job.trash) { return 0 }
    }
    if job.published || (job.kind == 3 && job.node_count > 0) {
        ResumePublished()
        return 1
    }
    retained := job.replacement_done || (job.replacement != null && job.replacement.published)
    if job.replacement != null && !retained {
        if !DisposeReplacement() { return 0 }
    }
    pointers: [256]*s8
    count := job.status.total - job.index
    index: s32 = 0
    while index < count { pointers[index] = *job.items[job.index + index].source[0]; index += 1 }
    recovery: *Trash.Entry = null
    if job.kind == 2 || job.kind == 3 { recovery = *job.trash }
    next := Prepare(*job.status.operation[0], *pointers[0], count, *job.destination[0], recovery, job.kind)
    if next == null { return 0 }
    index = 0
    while index < count { job.items[job.index + index].info = next.items[index].info; index += 1 }
    CopyText(*job.directory[0], 1024, *next.directory[0])
    ReleaseAllocation(cast(*void)next)
    ClearNodes()
    if job.kind == 1 { job.trash = .{} }
    job.status.running = 1
    job.status.cancelled = 0
    job.status.conflict = 0
    job.status.error[0] = 0
    job.status.conflict_destination[0] = 0
    job.phase = 0
    if retained { job.replacing = true; PlanStart() }
    else { job.replacing = false; job.replacement_done = false; job.conflict_info = .{} }
    return cast(s32)(job.status.running != 0)
}

NativeCopyResolve :: (answer: s32, apply_to_all: s32) -> s32 {
    if job == null || job.status.running == 0 || job.status.conflict == 0 { return 0 }
    if answer == 0 { NativeCopyCancel(); return 1 }
    if answer == 1 { if apply_to_all != 0 { job.sticky = 1 }; Next(true); return 1 }
    if answer == 2 {
        if !CanReplace() { Fail("The destination changed, is unsupported, or overlaps a selected source"); return 0 }
        if apply_to_all != 0 { job.sticky = 2 }
        job.replacing = true
        job.status.conflict = 0
        job.status.conflict_destination[0] = 0
        PlanStart()
        return cast(s32)(job.status.running != 0)
    }
    if answer != 3 { return 0 }
    if apply_to_all != 0 { job.sticky = 3 }
    if !UniqueTarget() { Fail("Could not find an unused copy name"); return 0 }
    job.status.conflict = 0
    job.status.conflict_destination[0] = 0
    PlanStart()
    if job.status.running == 0 { return 0 }
    return 1
}

#scope_file
Drain :: (error: *s8, capacity: s32) -> s32 {
    status: FileTransferStatus
    while true {
        if NativeCopyPoll(*status) == 0 { CopyText(error, capacity, TextBytes("The operation could not be started")); return 0 }
        if status.running == 0 || status.conflict != 0 { break }
    }
    CopyText(error, capacity, *status.error[0])
    return cast(s32)(status.running == 0 && status.error[0] == 0 && status.completed == status.total)
}

#scope_export
NativeTrashRestore :: (name: *s8, error: *s8, capacity: s32) -> s32 {
    CopyText(error, capacity, TextBytes(""))
    if job != null && job.status.running != 0 { CopyText(error, capacity, TextBytes("Another file operation is still running")); return 0 }
    root: [1024]s8
    entry := cast(*Trash.Entry)AllocateZeroed(1, size_of(Trash.Entry))
    ok := entry != null && Trash.Root(*root[0], false) && Trash.Read(*root[0], name, entry) && Trash.Load(entry)
    parent: [1024]s8
    if ok {
        CopyText(*parent[0], 1024, *entry.original[0])
        split := TextLength(*parent[0])
        while split > 0 && parent[split - 1] != 47 { split -= 1 }
        if split > 1 { parent[split - 1] = 0 } else { parent[1] = 0 }
        ok = NativeFiles.EnsureDirectory(*parent[0])
    }
    source: [1]*s8
    if ok {
        source[0] = *entry.data[0]
        ok = Start(TextBytes("restore"), *source[0], 1, *parent[0], entry, 2) != 0
        if ok { CopyText(*job.items[0].target[0], 1024, *entry.original[0]) }
    }
    if !ok && entry != null { Trash.Release(entry) }
    ReleaseAllocation(cast(*void)entry)
    if !ok { CopyText(error, capacity, TextBytes("The Trash entry or its original directory could not be verified")); return 0 }
    return Drain(error, capacity)
}

NativeTrashEmpty :: (error: *s8, capacity: s32) -> s32 {
    CopyText(error, capacity, TextBytes(""))
    if job != null && job.status.running != 0 { CopyText(error, capacity, TextBytes("Another file operation is still running")); return 0 }
    root: [1024]s8
    if !Trash.Root(*root[0], true) { CopyText(error, capacity, TextBytes("The Trash directory could not be verified")); return 0 }
    cursor := File.OpenDirectory(CString(*root[0]))
    if !cursor.valid { CopyText(error, capacity, TextBytes("Could not list Trash")); return 0 }
    entry := cast(*Trash.Entry)AllocateZeroed(1, size_of(Trash.Entry))
    if entry == null { File.CloseDirectory(*cursor); CopyText(error, capacity, TextBytes("Could not allocate the Trash snapshot")); return 0 }
    ok := true
    source: [1]*s8
    while true {
        child := File.NextDirectoryEntry(*cursor)
        if !child.valid { break }
        if !Trash.Read(*root[0], cast(*s8)(*child.name[0]), entry) || !Trash.Load(entry) {
            ok = false
            CopyText(error, capacity, TextBytes("Unverified or incomplete Trash entries were preserved"))
            continue
        }
        source[0] = *entry.data[0]
        if Start(TextBytes("empty"), *source[0], 1, *root[0], entry, 3) == 0 {
            Trash.Release(entry)
            CopyText(error, capacity, TextBytes("The Trash entry could not be verified")); ok = false; break
        }
        if Drain(error, capacity) == 0 { ok = false; break }
    }
    failed := cursor.failed
    closed := File.CloseDirectory(*cursor)
    ReleaseAllocation(cast(*void)entry)
    if failed || !closed { CopyText(error, capacity, TextBytes("Could not read the complete Trash directory")); return 0 }
    if !ok && (error == null || capacity <= 0 || error[0] == 0) { CopyText(error, capacity, TextBytes("Some Trash entries were preserved")) }
    return cast(s32)ok
}
