using UI :: #import "Widgets";
#import "desktop_files"
#import "desktop_types"
#import "platform_types"
#import "settings"
#import "native_memory"
#import "ui_text"
Utf8 :: #import "utf8";

DesktopFilesState :: struct {
    started: bool
    files: *DesktopFiles
    cells: [256]Rectangle
    origins: [256]Vector2
    before: [256]bool
    focus: bool
    refresh_at: s64
    refresh: bool
    press_index: s32
    press_modified: bool
    drag: bool
    band_active: bool
    band_add: bool
    start: Vector2
    band: Rectangle
    click_key: u64
    click_at: s64
    context: bool
    context_x: float32
    context_y: float32
    context_bounds: Rectangle
    action: s32 // 1 rename, 2 new folder, 3 trash confirmation, 4 details
    modal_bounds: Rectangle
    name: [256]s8
    source: [1024]s8
    cursor: s32
    anchor: s32
    text_scroll: s32
    text_focused: bool
    transfer: FileTransferStatus
    transfer_text: [96]s8
    transfer_visible: bool
    transfer_bounds: Rectangle
}

#scope_file
Label :: (session: Session, key: u64, bounds: Rectangle, text: string) {
    props: TextProps
    props.key = key
    props.bounds = bounds
    props.text = text
    props.font = 12
    Text(session, props)
}

Button :: (session: Session, key: u64, bounds: Rectangle, text: string, disabled: bool) -> bool {
    props: ButtonProps
    props.key = key
    props.bounds = bounds
    props.label = text
    props.disabled = disabled
    return UI.Button(session, props) > 0
}

Status :: (app: *DesktopApplication, text: string) { CopyText(*app.shell.status[0], 160, TextBytes(text)) }

Hit :: (state: *DesktopFilesState, point: Vector2) -> s32 {
    index := state.files.count
    while index > 0 {
        index -= 1
        if PointInBounds(point.x, point.y, state.cells[index]) { return index }
    }
    return -1
}

DropFolder :: (state: *DesktopFilesState, point: Vector2) -> s32 {
    index := state.files.count
    while index > 0 {
        index -= 1
        item := *state.files.items[index]
        if !item.selected && item.launcher.is_directory != 0 &&
            item.launcher.file_path[0] != 0 && PointInBounds(point.x, point.y, state.cells[index]) { return index }
    }
    return -1
}

Open :: (state: *DesktopFilesState, app: *DesktopApplication, platform: *RillPlatformServices) {
    index: s32 = 0
    while index < state.files.count {
        if state.files.items[index].selected && !DesktopFilesOpen(state.files, index, *app.shell,
            platform, *app.settings, *app.previous, *app.settings_path[0]) { Status(app, "Could not open the selected item") }
        index += 1
    }
}

Paths :: (state: *DesktopFilesState, output: **s8) -> s32 { return DesktopFilesSelectedPaths(state.files, output, DesktopItemLimit) }

Copy :: (state: *DesktopFilesState, app: *DesktopApplication, platform: *RillPlatformServices, cut: bool) {
    paths: [256]*s8
    count := Paths(state, *paths[0])
    if count > 0 && platform != null && platform.file_clipboard_copy != null &&
        platform.file_clipboard_copy(*paths[0], count, cast(s32)cut) != 0 { Status(app, "Files copied to the clipboard") }
    else { Status(app, "Could not copy the selected files") }
}

Paste :: (state: *DesktopFilesState, app: *DesktopApplication, platform: *RillPlatformServices, into: bool) {
    if platform == null || platform.file_clipboard_paste == null || platform.desktop_directory == null { return }
    destination := platform.desktop_directory()
    selected := state.files.focused
    if into && selected >= 0 && state.files.items[selected].launcher.is_directory != 0 {
        destination = *state.files.items[selected].launcher.file_path[0]
    }
    if destination != null && destination[0] != 0 && platform.file_clipboard_paste(destination) != 0 {
        state.transfer_visible = true
        state.refresh = true
    } else { Status(app, "Could not paste files") }
}

Action :: (state: *DesktopFilesState, action: s32, platform: *RillPlatformServices) {
    state.action = action
    state.source[0] = 0
    state.name[0] = 0
    selected := state.files.focused
    if action == 2 {
        if platform != null && platform.desktop_directory != null {
            CopyText(*state.source[0], 1024, platform.desktop_directory())
        }
        CopyText(*state.name[0], 256, TextBytes("New Folder"))
    } else if selected >= 0 && selected < state.files.count {
        item := state.files.items[selected].launcher
        CopyText(*state.source[0], 1024, *item.file_path[0])
        CopyText(*state.name[0], 256, *item.name[0])
        if action == 1 {
            start: s32 = 0
            index: s32 = 0
            while state.source[index] != 0 {
                if state.source[index] == 47 { start = index + 1 }
                index += 1
            }
            CopyText(*state.name[0], 256, *state.source[start])
        }
    }
    state.cursor = TextLength(*state.name[0])
    state.anchor = 0
    state.text_focused = true
}

Transfer :: (state: *DesktopFilesState, app: *DesktopApplication, platform: *RillPlatformServices, operation: string) -> bool {
    paths: [256]*s8
    count := Paths(state, *paths[0])
    destination: *s8 = null
    if platform != null && platform.desktop_directory != null { destination = platform.desktop_directory() }
    if count > 0 && platform != null && platform.file_transfer_start != null &&
        platform.file_transfer_start(TextBytes(operation), *paths[0], count, destination) != 0 {
        state.transfer_visible = true
        state.refresh = true
        return true
    } else { Status(app, "Could not start the file operation") }
    return false
}

Keyboard :: (session: Session, state: *DesktopFilesState, app: *DesktopApplication,
    platform: *RillPlatformServices, control: bool, shift: bool) {
    key := KeyboardTake(session)
    selected := state.files.focused
    if key == KeyEscape {
        state.drag = false; state.band_active = false; state.press_index = -1; state.click_key = cast(u64)0
    }
    if key == KeyEnter { Open(state, app, platform) }
    if key == KeyHome && state.files.count > 0 { DesktopFilesSelect(state.files, 0, control, shift) }
    if key == KeyEnd && state.files.count > 0 { DesktopFilesSelect(state.files, state.files.count - 1, control, shift) }
    if key == KeyLeft || key == KeyRight || key == KeyUp || key == KeyDown {
        origin := Vector2.{0.0, 0.0}
        if selected >= 0 { origin = Vector2.{state.cells[selected].x, state.cells[selected].y} }
        best: s32 = -1
        score: float32 = 1.0e20
        index: s32 = 0
        while index < state.files.count {
            dx := state.cells[index].x - origin.x
            dy := state.cells[index].y - origin.y
            forward := (key == KeyLeft && dx < 0.0) || (key == KeyRight && dx > 0.0) ||
                (key == KeyUp && dy < 0.0) || (key == KeyDown && dy > 0.0)
            distance := dx * dx + dy * dy
            if selected < 0 || (forward && distance < score) { best = index; score = distance }
            index += 1
        }
        if best >= 0 { DesktopFilesSelect(state.files, best, control, shift) }
    }
    if control && key == 65 {
        index: s32 = 0
        while index < state.files.count { state.files.items[index].selected = true; index += 1 }
        if state.files.count > 0 { state.files.focused = 0; state.files.anchor = 0 }
    }
    if control && (key == 67 || key == 88) { Copy(state, app, platform, key == 88) }
    if control && key == 86 { Paste(state, app, platform, false) }
    if control && key == 68 { Transfer(state, app, platform, "duplicate") }
    if key == KeyDelete { Action(state, 3, platform) }
    // Type-to-select uses the app's existing UTF-8 display names.
    scalar := TypedCodepointTake(session)
    if !control && scalar >= 32 {
        index: s32 = 0
        while index < state.files.count {
            decoded := Utf8.Decode(CString(*state.files.items[index].launcher.name[0]), 0)
            byte := cast(s32)decoded.value
            if byte >= 65 && byte <= 90 { byte += 32 }
            folded := scalar
            if folded >= 65 && folded <= 90 { folded += 32 }
            if byte == folded { DesktopFilesSelect(state.files, index, false, false); break }
            index += 1
        }
    }
}

Layout :: (state: *DesktopFilesState, work: Rectangle, point: Vector2) {
    rows := cast(s32)((work.height - 28.0) / 94.0)
    if rows < 1 { rows = 1 }
    index: s32 = 0
    while index < state.files.count {
        item := *state.files.items[index]
        x := work.x + 28.0 + cast(float32)(index / rows) * 94.0
        y := work.y + 28.0 + cast(float32)(index % rows) * 94.0
        if item.positioned { x = cast(float32)item.x; y = cast(float32)item.y }
        if state.drag && item.selected {
            x = state.origins[index].x + point.x - state.start.x
            y = state.origins[index].y + point.y - state.start.y
        }
        if x > work.x + work.width - 84.0 { x = work.x + work.width - 84.0 }
        if y > work.y + work.height - 82.0 { y = work.y + work.height - 82.0 }
        if x < work.x { x = work.x }
        if y < work.y { y = work.y }
        state.cells[index] = Rectangle.{x, y, 84.0, 82.0}
        index += 1
    }
}

#scope_export
DesktopFileGrid :: (session: Session, work: Rectangle, state: *DesktopFilesState,
    app: *DesktopApplication, platform: *RillPlatformServices, enabled: bool, now: s64) {
    if !state.started {
        state.files = cast(*DesktopFiles)AllocateZeroed(1, size_of(DesktopFiles))
        if state.files == null { Status(app, "Could not allocate desktop files"); return }
        DesktopFilesInitialize(state.files, platform)
        if platform != null && platform.file_transfer_conflicts != null { platform.file_transfer_conflicts() }
        state.press_index = -1
        state.started = true
        state.refresh = true
    }
    pointer := PointerSample(session)
    point := Vector2.{pointer.x, pointer.y}
    enabled = enabled && !state.context && state.action == 0 && state.transfer.conflict == 0 &&
        !PointInBounds(point.x, point.y, state.transfer_bounds)
    if state.press_index < 0 && !state.band_active && state.action == 0 && !state.context &&
        (state.refresh || now < state.refresh_at || now - state.refresh_at >= 2000) {
        if DesktopFilesRefresh(state.files, *app.shell, platform) { state.refresh = false }
        state.refresh_at = now
    }
    Layout(state, work, point)
    if !enabled && pointer.released {
        state.press_index = -1
        state.drag = false
        state.band_active = false
    }
    modifiers := KeyboardModifiers(session)
    control := (modifiers & KeyModifierControl) != 0
    shift := (modifiers & KeyModifierShift) != 0
    hit := Hit(state, point)
    inside := PointInBounds(point.x, point.y, work)
    if enabled && inside && SecondaryPointerSample(session).pressed {
        if hit >= 0 && !state.files.items[hit].selected { DesktopFilesSelect(state.files, hit, false, false) }
        if hit < 0 { DesktopFilesClear(state.files) }
        state.context = true
        state.context_x = point.x
        state.context_y = point.y
        state.focus = true
    }
    if enabled && pointer.pressed {
        state.focus = inside
        if inside {
            state.start = point
            state.press_modified = control || shift
            if hit >= 0 {
                if !state.files.items[hit].selected || control || shift { DesktopFilesSelect(state.files, hit, control, shift) }
                state.press_index = hit
                index: s32 = 0
                while index < state.files.count { state.origins[index] = Vector2.{state.cells[index].x, state.cells[index].y}; index += 1 }
            } else {
                if !control { DesktopFilesClear(state.files) }
                index: s32 = 0
                while index < state.files.count { state.before[index] = state.files.items[index].selected; index += 1 }
                state.band_active = true
                state.band_add = control
                state.click_key = cast(u64)0
            }
        }
    }
    if enabled && state.press_index >= 0 && pointer.down {
        dx := point.x - state.start.x
        dy := point.y - state.start.y
        if dx * dx + dy * dy >= 36.0 { state.drag = true; TreePointerCancel(session) }
    }
    if enabled && state.band_active {
        left := point.x
        top := point.y
        right := state.start.x
        bottom := state.start.y
        if left > right { left = state.start.x; right = point.x }
        if top > bottom { top = state.start.y; bottom = point.y }
        state.band = Rectangle.{left, top, right - left, bottom - top}
        index: s32 = 0
        while index < state.files.count {
            cell := state.cells[index]
            intersects := cell.x < right && cell.x + cell.width > left && cell.y < bottom && cell.y + cell.height > top
            state.files.items[index].selected = intersects || (state.band_add && state.before[index])
            index += 1
        }
        if pointer.released {
            state.band_active = false
            state.files.focused = -1
            state.files.anchor = -1
            index = 0
            while index < state.files.count {
                if state.files.items[index].selected { state.files.focused = index; state.files.anchor = index; break }
                index += 1
            }
        }
    }
    if enabled && pointer.released && state.press_index >= 0 {
        if state.drag {
            target := DropFolder(state, point)
            paths: [256]*s8
            count := Paths(state, *paths[0])
            into := target >= 0 && !state.files.items[target].selected &&
                state.files.items[target].launcher.is_directory != 0 && count > 0
            if into {
                operation := TextBytes("move")
                if control { operation = TextBytes("copy") }
                if platform != null && platform.file_transfer_start != null &&
                    platform.file_transfer_start(operation, *paths[0], count, *state.files.items[target].launcher.file_path[0]) != 0 {
                    state.transfer_visible = true; state.refresh = true
                } else { Status(app, "Could not drop files into the folder") }
            } else {
                Layout(state, work, point)
                index: s32 = 0
                while index < state.files.count {
                    if state.files.items[index].selected {
                        state.files.items[index].x = cast(s32)state.cells[index].x
                        state.files.items[index].y = cast(s32)state.cells[index].y
                        state.files.items[index].positioned = true
                    }
                    index += 1
                }
                if !DesktopFilesSavePositions(state.files) { Status(app, "Could not save desktop icon positions") }
            }
            state.click_key = cast(u64)0
        } else if !state.press_modified && inside && hit == state.press_index {
            key := state.files.items[hit].key
            single := RillSettingsGetInteger(*app.settings, TextBytes("desktop-single-click"), 0) != 0
            if single || (state.click_key == key && now >= state.click_at && now - state.click_at <= 450) {
                Open(state, app, platform); state.click_key = cast(u64)0
            } else {
                state.click_key = key
                state.click_at = now
            }
        }
        state.press_index = -1
        state.drag = false
    }
    if enabled && state.focus { Keyboard(session, state, app, platform, control, shift) }
    Layout(state, work, point)
    index: s32 = 0
    while index < state.files.count {
        item := *state.files.items[index]
        cell := state.cells[index]
        props: SelectableProps
        props.key = item.key
        props.bounds = cell
        props.selected = item.selected
        props.disabled = !enabled
        Selectable(session, props)
        if item.launcher.icon_path[0] != 0 {
            image: ImageProps
            image.key = item.key + cast(u64)1
            image.bounds = Rectangle.{cell.x + 22.0, cell.y + 4.0, 40.0, 40.0}
            image.asset_path = CString(*item.launcher.icon_path[0])
            image.alt_text = CString(*item.launcher.description[0])
            image.fit = cast(ImageFit)1
            Image(session, image)
        } else {
            mark: BoxProps
            mark.key = item.key + cast(u64)1
            mark.bounds = Rectangle.{cell.x + 24.0, cell.y + 7.0, 36.0, 32.0}
            mark.radius = 4.0
            mark.fill = Color.{105, 151, 203, 255}
            Box(session, mark)
            type := "App"
            if item.launcher.file_path[0] != 0 { type = "File" }
            if item.launcher.is_directory != 0 || index < 2 { type = "Dir" }
            if index == 2 { type = "Bin" }
            Label(session, item.key + cast(u64)2, Rectangle.{cell.x + 29.0, cell.y + 16.0, 32.0, 20.0}, type)
        }
        text: TextProps
        text.key = item.key + cast(u64)3
        text.bounds = Rectangle.{cell.x + 2.0, cell.y + 48.0, 80.0, 30.0}
        text.text = CString(*item.launcher.name[0])
        text.font = 12
        Text(session, text)
        index += 1
    }
    if state.band_active {
        box: BoxProps
        box.key = cast(u64)220001
        box.bounds = state.band
        box.fill = Color.{80, 140, 230, 48}
        box.border = Color.{80, 140, 230, 200}
        Box(session, box)
    }
}

DesktopFilesOverlay :: (session: Session, viewport: Rectangle, state: *DesktopFilesState,
    app: *DesktopApplication, platform: *RillPlatformServices) {
    if state.files == null { return }
    state.context_bounds = .{}
    state.modal_bounds = .{}
    state.transfer_bounds = .{}
    paths: [256]*s8
    count := Paths(state, *paths[0])
    if state.context {
        items: [12]ContextMenuItem
        selected := state.files.focused
        folder := selected >= 0 && state.files.items[selected].launcher.is_directory != 0
        available := platform != null
        length: s32 = 0
        if selected >= 0 { items[length] = .{id = 1, label = "Open"}; length += 1 }
        if count > 0 {
            items[length] = .{id = 2, label = "Cut", disabled = !available || platform.file_clipboard_copy == null}; length += 1
            items[length] = .{id = 3, label = "Copy", disabled = !available || platform.file_clipboard_copy == null}; length += 1
            if folder { items[length] = .{id = 5, label = "Paste into folder", disabled = !available || platform.file_clipboard_paste == null}; length += 1 }
            items[length] = .{id = 6, label = "Rename", disabled = count != 1 || !available || platform.file_operation == null}; length += 1
            items[length] = .{id = 8, label = "Move to Trash", disabled = !available || platform.file_transfer_start == null}; length += 1
            items[length] = .{id = 9, label = "Duplicate", disabled = !available || platform.file_transfer_start == null}; length += 1
        }
        if selected >= 0 { items[length] = .{id = 10, label = "Properties"}; length += 1 }
        if selected < 0 {
            items[length] = .{id = 4, label = "Paste", disabled = !available || platform.file_clipboard_paste == null}; length += 1
            items[length] = .{id = 7, label = "New Folder", disabled = !available || platform.file_operation == null || platform.desktop_directory == null}; length += 1
            items[length] = .{id = 11, label = "Arrange icons", disabled = state.files.layout_path[0] == 0}; length += 1
        }
        items[length] = .{id = 12, label = "Refresh"}; length += 1
        props: ContextMenuProps
        props.key = cast(u64)220010
        props.open = true
        props.x = state.context_x
        props.y = state.context_y
        props.escape = KeyboardTake(session) == KeyEscape
        state.context_bounds = ContextMenuBounds(items[0:length], props.x, props.y, viewport)
        result := ContextMenu(session, props, items[0:length])
        state.context = result.open
        command := result.activated_id
        if command == 1 { Open(state, app, platform) }
        if command == 2 || command == 3 { Copy(state, app, platform, command == 2) }
        if command == 4 || command == 5 { Paste(state, app, platform, command == 5) }
        if command == 6 { Action(state, 1, platform) }
        if command == 7 { Action(state, 2, platform) }
        if command == 8 { Action(state, 3, platform) }
        if command == 9 { Transfer(state, app, platform, "duplicate") }
        if command == 10 { Action(state, 4, platform) }
        if command == 11 && !DesktopFilesArrange(state.files) { Status(app, "Could not save the arranged desktop") }
        if command == 12 { state.refresh = true }
    }
    if state.action != 0 { FileDialog(session, viewport, state, app, platform) }
    TransferStatus(session, viewport, state, app, platform)
}

DesktopFilesClose :: (state: *DesktopFilesState, platform: *RillPlatformServices) {
    if platform != null && platform.file_transfer_finish != null { platform.file_transfer_finish() }
    ReleaseAllocation(cast(*void)state.files)
    state.files = null
    state.started = false
}

#scope_file
FileDialog :: (session: Session, viewport: Rectangle, state: *DesktopFilesState,
    app: *DesktopApplication, platform: *RillPlatformServices) {
    bounds := Rectangle.{viewport.x + 16.0, viewport.y + 68.0, viewport.width - 32.0, 170.0}
    state.modal_bounds = bounds
    props: DismissibleOverlayProps
    props.key = cast(u64)220100
    props.bounds = bounds
    overlay := DismissibleOverlay(session, props)
    if overlay.closed { state.action = 0; return }
    TreePushScope(session, overlay.panel_node)
    titles: [4]string = .["Rename", "New Folder", "Move selected files to Trash?", "Properties"]
    Label(session, cast(u64)220101, Rectangle.{bounds.x + 12.0, bounds.y + 12.0, bounds.width - 24.0, 24.0}, titles[state.action - 1])
    key := KeyboardTake(session)
    if state.action == 1 || state.action == 2 {
        typed: [128]u8
        field: TextFieldProps
        field.key = cast(u64)220102
        field.focus_id = 220102
        field.bounds = Rectangle.{bounds.x + 12.0, bounds.y + 44.0, bounds.width - 24.0, 32.0}
        field.value = CString(*state.name[0])
        field.max_bytes = 255
        field.cursor = state.cursor
        field.anchor = state.anchor
        field.scroll_x = state.text_scroll
        field.focused = state.text_focused
        field.input = TextFieldInputFor(key, KeyboardModifiers(session), TypedTextTake(session, typed[:]))
        edit := TextField(session, field)
        ApplyTextEdit(*state.name[0], 256, edit.edit)
        state.cursor = edit.cursor
        state.anchor = edit.anchor
        state.text_scroll = edit.scroll_x
        state.text_focused = edit.focused
    } else if state.action == 4 {
        Label(session, cast(u64)220102, Rectangle.{bounds.x + 12.0, bounds.y + 42.0, bounds.width - 24.0, 24.0}, CString(*state.name[0]))
        Label(session, cast(u64)220103, Rectangle.{bounds.x + 12.0, bounds.y + 70.0, bounds.width - 24.0, 44.0}, CString(*state.source[0]))
    }
    editable := state.action == 1 || state.action == 2
    disabled := platform == null
    if editable { disabled = disabled || !DesktopNameValid(*state.name[0]) || platform.file_operation == null }
    if state.action == 3 {
        paths: [256]*s8
        disabled = disabled || platform.file_transfer_start == null || Paths(state, *paths[0]) == 0
    }
    confirm := false
    if state.action != 4 {
        confirm = Button(session, cast(u64)220104, Rectangle.{bounds.x + 12.0, bounds.y + 118.0, bounds.width / 2.0 - 18.0, 32.0}, "Confirm", disabled)
    }
    if state.action != 4 && !disabled && (confirm || key == KeyEnter) {
        ok: bool = false
        if state.action == 3 {
            ok = Transfer(state, app, platform, "trash")
        } else {
            operation := TextBytes("rename")
            if state.action == 2 { operation = TextBytes("mkdir") }
            error: [256]s8
            ok = platform.file_operation(operation, *state.source[0], *state.name[0], *error[0], 256) != 0
            if !ok { CopyText(*app.shell.status[0], 160, *error[0]) }
        }
        if ok { state.action = 0; state.refresh = true }
    }
    if Button(session, cast(u64)220105, Rectangle.{bounds.x + bounds.width / 2.0, bounds.y + 118.0, bounds.width / 2.0 - 12.0, 32.0}, "Close", false) || key == KeyEscape {
        state.action = 0
    }
    End(session)
}

TransferStatus :: (session: Session, viewport: Rectangle, state: *DesktopFilesState,
    app: *DesktopApplication, platform: *RillPlatformServices) {
    if platform == null || platform.file_transfer_poll == null { return }
    old := state.transfer.id
    was_running := state.transfer.running
    if platform.file_transfer_poll(*state.transfer) == 0 { return }
    if state.transfer.running != 0 || state.transfer.id != old { state.transfer_visible = true }
    if was_running != 0 && state.transfer.running == 0 { state.refresh = true }
    if !state.transfer_visible || state.action != 0 { return }
    width := viewport.width - 32.0
    if width > 420.0 { width = 420.0 }
    bounds := Rectangle.{viewport.x + viewport.width - width - 16.0,
        viewport.y + viewport.height - 174.0, width, 158.0}
    state.transfer_bounds = bounds
    box: BoxProps
    box.key = cast(u64)220200
    box.bounds = bounds
    box.fill = Color.{248, 249, 252, 255}
    box.border = Color.{140, 160, 180, 255}
    Box(session, box)
    Label(session, cast(u64)220201, Rectangle.{bounds.x + 8.0, bounds.y + 8.0, width - 16.0, 24.0}, CString(*state.transfer.operation[0]))
    used := FormatInteger(*state.transfer_text[0], 96, state.transfer.completed)
    used += CopyText(*state.transfer_text[used], 96 - used, TextBytes(" / "))
    FormatInteger(*state.transfer_text[used], 96 - used, state.transfer.total)
    Label(session, cast(u64)220202, Rectangle.{bounds.x + 8.0, bounds.y + 32.0, width - 16.0, 24.0}, CString(*state.transfer_text[0]))
    if state.transfer.conflict != 0 {
        Label(session, cast(u64)220203, Rectangle.{bounds.x + 8.0, bounds.y + 56.0, width - 16.0, 36.0}, CString(*state.transfer.conflict_destination[0]))
        labels: [4]string = .["Cancel", "Skip", "Replace", "Keep both"]
        index: s32 = 0
        while index < 4 {
            if Button(session, cast(u64)(220210 + index), Rectangle.{bounds.x + 8.0 + cast(float32)index * (width - 16.0) / 4.0,
                bounds.y + 108.0, (width - 24.0) / 4.0, 32.0}, labels[index], platform.file_transfer_resolve == null) {
                if platform.file_transfer_resolve(index, 0) == 0 { Status(app, "Could not resolve the file conflict") }
            }
            index += 1
        }
    } else {
        message := CString(*state.transfer.current[0])
        if state.transfer.error[0] != 0 { message = CString(*state.transfer.error[0]) }
        Label(session, cast(u64)220203, Rectangle.{bounds.x + 8.0, bounds.y + 56.0, width - 16.0, 36.0}, message)
        if state.transfer.running != 0 {
            if Button(session, cast(u64)220210, Rectangle.{bounds.x + 8.0, bounds.y + 108.0, width - 16.0, 32.0}, "Cancel", platform.file_transfer_cancel == null) { platform.file_transfer_cancel() }
        } else {
            if Button(session, cast(u64)220210, Rectangle.{bounds.x + 8.0, bounds.y + 108.0, (width - 24.0) / 3.0, 32.0}, "Retry", platform.file_transfer_retry == null) {
                if platform.file_transfer_retry() == 0 { Status(app, "Nothing could be retried") }
            }
            if Button(session, cast(u64)220211, Rectangle.{bounds.x + 12.0 + (width - 24.0) / 3.0, bounds.y + 108.0, (width - 24.0) / 3.0, 32.0}, "Undo", platform.file_transfer_undo == null) {
                if platform.file_transfer_undo() == 0 { Status(app, "Nothing could be undone") }
            }
            if Button(session, cast(u64)220212, Rectangle.{bounds.x + 16.0 + (width - 24.0) * 2.0 / 3.0, bounds.y + 108.0, (width - 24.0) / 3.0, 32.0}, "Close", false) { state.transfer_visible = false }
        }
    }
}
