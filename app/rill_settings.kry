#import "kryon.h"
#import "rill_kry_ui.h"

app "Rill Settings" {
    size 540 440
    fps 60
}

state {
    tab: int = 0
    wallpaper_scroll: int = 0
    selected_panel: int = 0
    selected_output: int = 0
    selected_mode: int = 0
    rebinding: int = -1
}

SettingsTabs :: (x: float, y: float) #private {
    if RillKryButton(x + 12, y + 8, 138, 28, "Desktop", tab == 0) != 0 { tab = 0 }
    if RillKryButton(x + 158, y + 8, 138, 28, "System", tab == 1) != 0 { tab = 1 }
    if RillKryButton(x + 304, y + 8, 138, 28, "Panels", tab == 2) != 0 { tab = 2 }
    if RillKryButton(x + 450, y + 8, 76, 28, "Input", tab == 3) != 0 { tab = 3 }
}

DesktopTab :: (x: float, y: float, width: float) #private {
    Text((TextProps){.bounds = {x + 16, y + 12, 0, 0}, .text = "Appearance",
                     .font = Text18, .class_name = 1, .wrap = TextWrapNone})
    RillKryTextFit(x + 16, y + 40, width - 32, RillKryThemeName(), 2, 2)
    RillKryTextFit(x + 16, y + 60, width - 32, RillKryFontName(), 2, 2)
    Text((TextProps){.bounds = {x + 16, y + 86, 0, 0}, .text = "Wallpaper",
                     .font = Text14, .class_name = 1, .wrap = TextWrapNone})

    area: Rectangle = {x, y + 104, width, 108}
    if CheckCollisionPointRec(GetMousePosition(), area) {
        wallpaper_scroll = wallpaper_scroll - (int)GetMouseWheelMove()
        maximum: int = RillKryWallpaperCount() - 4
        if maximum < 0 { maximum = 0 }
        if wallpaper_scroll < 0 { wallpaper_scroll = 0 }
        if wallpaper_scroll > maximum { wallpaper_scroll = maximum }
    }
    BeginScissorMode((int)area.x, (int)area.y, (int)area.width, (int)area.height)
    row_y: int = (int)area.y
    count: int = RillKryWallpaperCount()
    if count <= 0 {
        RillKryTextFit(x + 16, (float)row_y + 6, width - 32,
                       "No wallpapers found in Pictures or system backgrounds", 2, 2)
    }
    i: int = 0
    for i = wallpaper_scroll; i < count; i++ {
        if i >= wallpaper_scroll + 4 { break }
        path: const char * = RillKryWallpaperPath(i)
        base: const char * = path
        scan: const char * = path
        while scan[0] != 0 {
            if scan[0] == '/' { base = scan + 1 }
            scan = scan + 1
        }
        current: const char * = RillKryWallpaperCurrent()
        chosen: int = 0
        j: int = 0
        while j < 512 {
            if path[j] != current[j] { chosen = 0 }
            if path[j] == 0 {
                if current[j] == 0 { chosen = 1 }
                break
            }
            if current[j] == 0 { break }
            j = j + 1
        }
        if RillKryButton(x + 12, (float)row_y + 2, width - 24, 22, base,
                         chosen) != 0 {
            RillKryWallpaperApply(path)
        }
        row_y = row_y + 26
    }
    EndScissorMode()

    row_y = (int)y + 216
    if RillKryButton(x + 12, (float)row_y, 150, 26, "System background", 0) != 0 {
        RillKryWallpaperSystem()
    }
    slideshow: const char * = RillKryWallpaperSlideshow() != 0 ?
        "Slideshow: 5 min" : "Slideshow: off"
    if RillKryButton(x + 172, (float)row_y, 150, 26, slideshow,
                     RillKryWallpaperSlideshow()) != 0 {
        RillKryWallpaperToggleSlideshow()
    }

    row_y = (int)y + 252
    Text((TextProps){.bounds = {x + 16, (float)row_y, 0, 0}, .text = "Clock",
                     .font = Text14, .class_name = 1, .wrap = TextWrapNone})
    clock_i: int = 0
        for clock_i = 0; clock_i < 3; clock_i++ {
        if RillKryButton(x + 12 + (float)i * 148, (float)row_y + 20, 140, 24,
                         RillKryClockSample(clock_i), RillKryClockFormatIs(clock_i)) != 0 {
            RillKryClockFormatSet(clock_i)
        }
    }

    row_y = (int)y + 312
    Text((TextProps){.bounds = {x + 16, (float)row_y + 4, 0, 0},
                     .text = "Panel height", .font = Text12, .class_name = 2,
                     .wrap = TextWrapNone})
    if RillKryButton(x + 240, (float)row_y, 26, 24, "-", 0) != 0 {
        RillKryPanelHeightChange(-1)
    }
    height_label: const char * = TextFormat("%d", RillKryPanelHeight())
    RillKryTextFit(x + 272, (float)row_y + 4, 34, height_label, 1, 1)
    if RillKryButton(x + 310, (float)row_y, 26, 24, "+", 0) != 0 {
        RillKryPanelHeightChange(1)
    }
}

SystemTab :: (x: float, y: float, width: float) #private {
    Text((TextProps){.bounds = {x + 16, y + 12, 0, 0}, .text = "System settings",
                     .font = Text18, .class_name = 1, .wrap = TextWrapNone})
    RillKryTextFit(x + 16, y + 42, width - 32,
                   "Open the installed control panel for each device or service.",
                   2, 2)
    cell: float = (width - 36) / 2
    row: int = 0
        for row = 0; row < 10; row++ {
        bx: float = x + 12 + (float)(row % 2) * (cell + 12)
        by: float = y + 72 + (float)(row / 2) * 44
        if RillKryButton(bx, by, cell, 34, RillKrySystemLabel(row), 0) != 0 {
            RillKrySystemOpen(row)
        }
    }
    RillKryTextFit(x + 16, y + 306, width - 32, RillKrySettingsError(), 2, 1)
    RillKryTextFit(x + 16, y + 328, width - 32, RillKryDiagnostics(), 2, 2)
}

PanelsTab :: (x: float, y: float, width: float) #private {
    Text((TextProps){.bounds = {x + 16, y + 12, 0, 0}, .text = "Panels",
                     .font = Text18, .class_name = 1, .wrap = TextWrapNone})
    RillKryTextFit(x + 16, y + 40, width - 32,
                   "Panel changes take effect at the next login.", 2, 2)
    entries: int = RillKryPanelEntryCount()
    row_y: int = (int)y + 68
    entry_i: int = 0
        for entry_i = 0; entry_i < entries; entry_i++ {
        if entry_i >= 5 { break }
        row: Rectangle = {x + 12, (float)row_y, width - 24, 44}
        if CheckCollisionPointRec(GetMousePosition(), row) {
            selected_panel = entry_i
        }
        if selected_panel == entry_i {
            DrawRectangleLinesEx(row, 1.0f, GetThemeLink())
        }
        RillKryTextFit(row.x + 10, row.y + 5, 96, RillKryPanelEntryId(entry_i), 1, 1)
        edge: const char * = "top"
        if RillKryPanelEntryEdge(entry_i) == 1 { edge = "bottom" }
        if RillKryPanelEntryEdge(entry_i) == 2 { edge = "left" }
        if RillKryPanelEntryEdge(entry_i) == 3 { edge = "right" }
        output: const char * = RillKryPanelEntryOutput(entry_i)
        placement: const char * = RillKryTextJoin(edge, output)
        RillKryTextFit(row.x + 112, row.y + 5, 150, placement, 2, 2)
        sizing: const char * = RillKryPanelEntryAutohide(entry_i) != 0 ?
            TextFormat("%d px, autohide", RillKryPanelEntrySize(entry_i)) :
            TextFormat("%d px", RillKryPanelEntrySize(entry_i))
        RillKryTextFit(row.x + 268, row.y + 5, 90, sizing, 2, 2)
        edge_label: const char * = "T"
        if RillKryPanelEntryEdge(entry_i) == 1 { edge_label = "B" }
        if RillKryPanelEntryEdge(entry_i) == 2 { edge_label = "L" }
        if RillKryPanelEntryEdge(entry_i) == 3 { edge_label = "R" }
        if RillKryButton(row.x + row.width - 260, row.y + 15, 52, 24,
                         RillKryPanelEntryDeskbar(entry_i) != 0 ? "Desk" : "Bar",
                         RillKryPanelEntryDeskbar(entry_i)) != 0 {
            RillKryPanelEntryToggleDeskbar(entry_i)
        }
        if RillKryButton(row.x + row.width - 204, row.y + 15, 44, 24,
                         edge_label, 0) != 0 {
            RillKryPanelEntryCycleEdge(entry_i)
        }
        if RillKryButton(row.x + row.width - 156, row.y + 15, 30, 24, "-", 0) != 0 {
            RillKryPanelEntrySizeChange(entry_i, -2)
        }
        if RillKryButton(row.x + row.width - 122, row.y + 15, 30, 24, "+", 0) != 0 {
            RillKryPanelEntrySizeChange(entry_i, 2)
        }
        if RillKryButton(row.x + row.width - 88, row.y + 15, 44, 24, "Hide",
                         RillKryPanelEntryAutohide(entry_i)) != 0 {
            RillKryPanelEntryToggleAutohide(entry_i)
        }
        if RillKryButton(row.x + row.width - 40, row.y + 15, 38, 24, "Del", 0) != 0 {
            RillKryPanelEntryRemove(entry_i)
        }
        row_y = row_y + 50
    }
    if RillKryButton(x + 12, (float)row_y + 4, 110, 28, "Add Panel", 0) != 0 {
        RillKryPanelEntryAdd()
    }
    if RillKryPanelOutputCount() > 0 {
        if RillKryButton(x + 130, (float)row_y + 4, 150, 28, "Output", 0) != 0 {
            RillKryPanelEntryCycleOutput(selected_panel)
        }
    }
    if RillKryButton(x + width - 128, (float)row_y + 4, 116, 28,
                     "Save Panels", 0) != 0 {
        RillKryPanelsSave()
    }
    if RillKryButton(x + 12, (float)row_y + 36, 150, 26, "Import Xfce Panel", 0) != 0 {
        RillKryPanelsImportXfce()
    }
    RillKryTextFit(x + 16, (float)row_y + 66, width - 32, RillKryPanelError(), 2, 1)
}

InputTab :: (x: float, y: float, width: float) #private {
    row_y: int = (int)y + 8
    Text((TextProps){.bounds = {x + 16, (float)row_y, 0, 0}, .text = "Display",
                     .font = Text18, .class_name = 1, .wrap = TextWrapNone})
    row_y = row_y + 28
    outputs: int = RillKryDisplayOutputCount()
    if outputs > 0 {
        if selected_output >= outputs { selected_output = 0 }
        if RillKryButton(x + 16, (float)row_y, 130, 26,
                         RillKryDisplayOutputName(selected_output), 0) != 0 {
            selected_output = (selected_output + 1) % outputs
        }
        modes: int = RillKryDisplayModeCount(selected_output)
        if modes > 0 {
            if selected_mode >= modes { selected_mode = 0 }
            if RillKryButton(x + 156, (float)row_y, 110, 26,
                             RillKryDisplayModeLabel(selected_mode), 0) != 0 {
                selected_mode = (selected_mode + 1) % modes
            }
            if RillKryDisplayConfirmRemaining() == 0 {
                if RillKryButton(x + 276, (float)row_y, 100, 26, "Apply", 0) != 0 {
                    RillKryDisplayApply(selected_output, selected_mode)
                }
            }
        }
        row_y = row_y + 32
        remaining: int = RillKryDisplayConfirmRemaining()
        if remaining > 0 {
            DrawRectangleRec((Rectangle){x + 12, (float)row_y - 4, width - 24, 30},
                             (Color){0x23, 0x27, 0x2e, 255})
            RillKryTextFit(x + 18, (float)row_y, width - 160,
                           TextFormat("Keep the new resolution? Reverting in %ds...",
                                      remaining), 2, 1)
            if RillKryButton(x + width - 130, (float)row_y - 2, 52, 26,
                             "Keep", 0) != 0 {
                RillKryDisplayKeep()
            }
            if RillKryButton(x + width - 72, (float)row_y - 2, 58, 26,
                             "Revert", 0) != 0 {
                RillKryDisplayRevert()
            }
        }
        RillKryTextFit(x + 16, (float)row_y + 30, width - 32,
                       RillKryDisplayError(), 2, 1)
        row_y = row_y + 58
    } else {
        RillKryTextFit(x + 16, (float)row_y, width - 32,
                       "No connected outputs were found.", 2, 2)
        row_y = row_y + 26
    }

    Text((TextProps){.bounds = {x + 16, (float)row_y, 0, 0},
                     .text = "Keyboard and Mouse", .font = Text18,
                     .class_name = 1, .wrap = TextWrapNone})
    row_y = row_y + 28
    RillKryTextFit(x + 16, (float)row_y, 240,
                   TextFormat("Repeat delay %d ms   rate %d/s",
                              RillKryKeyboardDelay(), RillKryKeyboardRate()), 2, 2)
    if RillKryButton(x + 260, (float)row_y - 4, 30, 24, "-", 0) != 0 {
        RillKryKeyboardChange(-50, 0)
    }
    if RillKryButton(x + 294, (float)row_y - 4, 30, 24, "+", 0) != 0 {
        RillKryKeyboardChange(50, 0)
    }
    if RillKryButton(x + 330, (float)row_y - 4, 30, 24, "-", 0) != 0 {
        RillKryKeyboardChange(0, -1)
    }
    if RillKryButton(x + 364, (float)row_y - 4, 30, 24, "+", 0) != 0 {
        RillKryKeyboardChange(0, 1)
    }
    row_y = row_y + 30
    RillKryTextFit(x + 16, (float)row_y, 240,
                   TextFormat("Mouse speed %d/%d  threshold %d",
                              RillKryMouseNumerator(), RillKryMouseDenominator(),
                              RillKryMouseThreshold()), 2, 2)
    if RillKryButton(x + 260, (float)row_y - 4, 30, 24, "-", 0) != 0 {
        RillKryMouseChange(-1, 0, 0)
    }
    if RillKryButton(x + 294, (float)row_y - 4, 30, 24, "+", 0) != 0 {
        RillKryMouseChange(1, 0, 0)
    }
    if RillKryButton(x + 330, (float)row_y - 4, 30, 24, "-", 0) != 0 {
        RillKryMouseChange(0, 0, -2)
    }
    if RillKryButton(x + 364, (float)row_y - 4, 30, 24, "+", 0) != 0 {
        RillKryMouseChange(0, 0, 2)
    }
    row_y = row_y + 34
    row_y = ShortcutsSection(x, row_y, width)
}

SettingsUI :: (viewport: Rectangle) #ui {
    SettingsTabs(viewport.x, viewport.y)
    body: Rectangle = {viewport.x, viewport.y + 40, viewport.width,
                       viewport.height - 40}
    if tab == 0 {
        DesktopTab(body.x, body.y, body.width)
    } else if tab == 1 {
        SystemTab(body.x, body.y, body.width)
    } else if tab == 2 {
        PanelsTab(body.x, body.y, body.width)
    } else {
        InputTab(body.x, body.y, body.width)
    }
}

ShortcutsSection :: (x: float, row_y: int, width: float) -> int #private {
    Text((TextProps){.bounds = {x + 16, (float)row_y, 0, 0},
                     .text = "Window Manager Shortcuts", .font = Text18,
                     .class_name = 1, .wrap = TextWrapNone})
    row_y = row_y + 26
    actions: int = RillKryWmActionCount()
    action_i: int = 0
        for action_i = 0; action_i < actions; action_i++ {
        if action_i >= 5 { break }
        RillKryTextFit(x + 18, (float)row_y + 5, 150, RillKryWmActionName(action_i), 2, 1)
        binding: const char * = rebinding == action_i ? "press keys..." :
            RillKryWmActionBinding(action_i)
        RillKryTextFit(x + 172, (float)row_y + 5, 170, binding, 2, 2)
        if RillKryButton(x + width - 92, (float)row_y, 78, 22, "Rebind", 0) != 0 {
            rebinding = rebinding == action_i ? -1 : action_i
        }
        row_y = row_y + 26
    }
    if rebinding >= 0 {
        if RillKryWmCaptureUpdate() != 0 {
            rebinding = -1
        }
    }
    if RillKryButton(x + 12, (float)row_y + 2, 96, 26, "Save Keys", 0) != 0 {
        RillKryWmKeysSave()
    }
    if RillKryButton(x + 116, (float)row_y + 2, 90, 26, "Reset", 0) != 0 {
        RillKryWmKeysReset()
    }
    RillKryTextFit(x + 16, (float)row_y + 34, width - 32, RillKryInputError(), 2, 1)
    return row_y + 34
}
