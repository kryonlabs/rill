#import "document_open"
#import "document_native"
#import "native_memory"
#import "c_string"
File :: #import "file_plan9";
Process :: #import "process_plan9";

Run :: (argc: s32, argv: **s8) -> s32 {
    if argc < 2 { print("usage: rill-open file ...\n"); return 1 }
    home := EnvironmentValue(TextBytes("home"))
    plan := cast(*DocumentPlan)AllocateZeroed(1, size_of(DocumentPlan))
    if plan == null { ReleaseAllocation(cast(*void)home); return 1 }
    cwd: [4096]u8
    directory := File.CurrentDirectory(cwd[:])
    result: s32 = 0
    index: s32 = 1
    while index < argc {
        absolute: [4096]s8
        file := CString(argv[index])
        if file.count > 0 && file[0] != cast(u8)47 {
            used := CopyText(*absolute[0], 4096, TextBytes(directory))
            if directory == "" || cast(s64)used + file.count + 1 >= 4096 {
                print("rill-open: cannot resolve %\n", file)
                result = 1
                index += 1
                continue
            }
            absolute[used] = 47
            CopyText(*absolute[used + 1], 4095 - used, TextBytes(file))
            file = CString(*absolute[0])
        }
        if !DocumentResolve(file, CString(home), "/lib/rill", plan) {
            print("rill-open: %: %\n", file, CString(*plan.error[0]))
            result = 1
        } else if !File.PathExists(TextView(plan.file[:TextLength(cast(*s8)(*plan.file[0]))])) ||
            File.DirectoryExists(TextView(plan.file[:TextLength(cast(*s8)(*plan.file[0]))])) {
            print("rill-open: not a document: %\n", file)
            result = 1
        } else {
            arguments: [16]string
            executable: [4096]u8
            if !DocumentArguments(plan, arguments[:], executable[:]) || !Process.StartDetached(arguments[0:plan.count]).valid {
                print("rill-open: could not start %\n", CString(*plan.application[0]))
                result = 1
            }
        }
        index += 1
    }
    ReleaseAllocation(cast(*void)plan)
    ReleaseAllocation(cast(*void)home)
    return result
}

#program_export
main :: (argc: s32, argv: **s8) -> s32 { return Run(argc, argv) }
