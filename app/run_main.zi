#import "run_dialog_ui"
#import "desktop_host"
#import "desktop_types"
#import "platform_types"
#import "native_memory"
using UI :: #import "Widgets";

state: RunDialogState;

DrawRun :: (session: Session, viewport: Rectangle,
    app: *DesktopApplication, platform: *RillPlatformServices) {
    RunDialog(session, viewport, *state, *app.shell, platform,
        *app.settings, *app.previous, *app.settings_path[0])
    app.closed = state.closed
}

#if #defined(PLAN9_BUILD) {
    #program_export
    threadmain :: (argc: s32, argv: **s8) {
        unused argc
        unused argv
        ApplicationMain(DrawRun)
    }
} else {
    #program_export
    main :: () -> s32 { return ApplicationMain(DrawRun) }
}
