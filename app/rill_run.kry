#import "kryon.h"
#import "rill_kry_ui.h"

app "Rill run dialog" {
    size 480 240
    fps 60
}

state {
    committed: int = 0
}

# The run dialog: type a command or application name, launch a match or a
# recent command. All shell state lives behind the rill_kry_ui bridge.
RunDialogUI :: () #ui {
    width: int = GetScreenWidth()
    input: char * = RillKryRunText()
    DrawRectangleRounded((Rectangle){0, 0, (float)width, 30}, 0.02f, 4,
                         (Color){0x19, 0x1c, 0x22, 255})
    Text((TextProps){
        .bounds = {10, 8, 0, 0}, .text = "Run program", .font = Text14,
        .class_name = 1, .wrap = TextWrapNone})
    DrawRectangleRounded((Rectangle){8, 40, (float)width - 16, 32}, 0.05f, 4,
                         Fade(BLACK, 0.22f))
    DrawRectangleRoundedLinesEx((Rectangle){8, 40, (float)width - 16, 32},
                                0.05f, 4, 1.0f, GetThemeLink())
    TextField((TextFieldProps){
        .bounds = {16, 44, (float)width - 32, 24},
        .text = input, .text_size = RillKryRunTextCap(),
        .cursor_position = RillKryRunCursor(), .focused = RillKryRunFocus(),
        .focus_id = 9801, .commit_pressed = &committed})
    if committed != 0 {
        committed = 0
        if RillKryRunLaunchText() != 0 {
            RillKryRunClose()
        }
    }
    if IsKeyPressed(KEY_ESCAPE) {
        RillKryRunClose()
    }

    y: int = 86
    if input[0] != 0 {
        matches: int = RillKryRunMatchCount()
        i: int = 0
        for i = 0; i < 6; i++ {
            if i >= matches { break }
            if RillKryButton(8, (float)y, (float)width - 16, 26,
                             RillKryRunMatchName(i), 0) != 0 {
                if RillKryRunLaunchMatch(i) != 0 {
                    RillKryRunClose()
                }
            }
            RillKryTextFit(200, (float)y + 5, (float)width - 220,
                           RillKryRunMatchDescription(i), 2, 2)
            y = y + 30
        }
        if matches == 0 {
            RillKryTextFit(16, (float)y + 2, (float)width - 32,
                           "Press Enter to run the typed command", 2, 2)
        }
        if IsKeyPressed(KEY_ENTER) {
            if RillKryRunLaunchText() != 0 {
                RillKryRunClose()
            }
        }
    } else {
        history: int = RillKryRunHistoryCount()
        if history == 0 {
            RillKryTextFit(16, 90, (float)width - 32,
                           "Recent commands appear here", 2, 2)
        }
        i: int = 0
        for i = 0; i < 4; i++ {
            if i >= history { break }
            if RillKryButton(8, (float)y, (float)width - 16, 26,
                             RillKryRunHistoryItem(i), 0) != 0 {
                if RillKryRunLaunchText() != 0 {
                    RillKryRunClose()
                }
            }
            y = y + 30
        }
    }
}
