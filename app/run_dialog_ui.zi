using UI :: #import "Widgets";
using Run :: #import "run_dialog";
#import "shell_types"
#import "platform_types"
#import "native_memory"

// Application-owned text storage; Kryon's TextField owns editing and rendering.
RunDialogState :: struct {
    text: [256]s8
    cursor: s32
    anchor: s32
    scroll_x: s32
    focused: bool
    started: bool
    closed: bool
}

#scope_file
Label :: (session: Session, key: u64, bounds: Rectangle, text: string, font: s32) {
    props: TextProps
    props.key = key
    props.bounds = bounds
    props.text = text
    props.font = font
    props.wrap = cast(TextWrap)1
    Text(session, props)
}

// Collect typed scalars into one bounded UTF-8 edit. Physical navigation keys
// remain independent, so a letter is inserted only once.
TypedText :: (session: Session, output: []u8) -> s32 {
    used: s32 = 0
    while true {
        scalar := TypedCodepointTake(session)
        if scalar == 0 { break }
        if scalar < 32 || scalar == 127 { continue }
        count: s32 = 1
        if scalar >= 128 { count = 2 }
        if scalar >= 2048 { count = 3 }
        if scalar >= 65536 { count = 4 }
        if used + count > cast(s32)output.count { break }
        if count == 1 { output[used] = cast(u8)scalar }
        if count == 2 {
            output[used] = cast(u8)(192 | (scalar >> 6))
            output[used + 1] = cast(u8)(128 | (scalar & 63))
        }
        if count == 3 {
            output[used] = cast(u8)(224 | (scalar >> 12))
            output[used + 1] = cast(u8)(128 | ((scalar >> 6) & 63))
            output[used + 2] = cast(u8)(128 | (scalar & 63))
        }
        if count == 4 {
            output[used] = cast(u8)(240 | (scalar >> 18))
            output[used + 1] = cast(u8)(128 | ((scalar >> 12) & 63))
            output[used + 2] = cast(u8)(128 | ((scalar >> 6) & 63))
            output[used + 3] = cast(u8)(128 | (scalar & 63))
        }
        used += count
    }
    return used
}

ApplyEdit :: (state: *RunDialogState, edit: TextFieldEdit) {
    if !edit.changed { return }
    length := TextLength(*state.text[0])
    replacement := cast(s32)edit.replacement.count
    after := length - (edit.end - edit.start) + replacement
    if edit.start < 0 || edit.end < edit.start || edit.end > length || after >= 256 { return }
    next: [256]s8
    index: s32 = 0
    while index < edit.start { next[index] = state.text[index]; index += 1 }
    byte: s32 = 0
    while byte < replacement {
        next[index] = cast(s8)edit.replacement[byte]
        index += 1
        byte += 1
    }
    byte = edit.end
    while byte < length { next[index] = state.text[byte]; index += 1; byte += 1 }
    next[index] = 0
    CopyText(*state.text[0], 256, *next[0])
}

Launch :: (state: *RunDialogState, shell: *RillShellState,
    platform: *RillPlatformServices, settings: *RillSettings,
    previous: *RillSettings, path: *s8, match: *RillLauncher, text: *s8) {
    if RillRunExecute(shell, platform, settings, previous, path, match, text) != 0 {
        state.closed = true
    }
}

#scope_export
#program_export
RunDialog :: (session: Session, viewport: Rectangle, state: *RunDialogState,
    shell: *RillShellState, platform: *RillPlatformServices,
    settings: *RillSettings, previous: *RillSettings, path: *s8) {
    if state == null || shell == null || state.closed { return }
    if !state.started { state.focused = true; state.started = true }
    key := KeyboardTake(session)
    if key == 256 { state.closed = true; return }
    header: BoxProps
    header.key = cast(u64)9800
    header.bounds = Rectangle.{viewport.x, viewport.y, viewport.width, 30.0}
    header.fill = Color.{229, 231, 235, 255}
    Box(session, header)
    Label(session, cast(u64)9802,
        Rectangle.{viewport.x + 10.0, viewport.y + 8.0, viewport.width - 20.0, 20.0},
        "Run program", 14)

    typed: [128]u8
    count := TypedText(session, typed[:])
    field: TextFieldProps
    field.key = cast(u64)9801
    field.focus_id = 9801
    field.bounds = Rectangle.{viewport.x + 8.0, viewport.y + 40.0, viewport.width - 16.0, 32.0}
    field.value = CString(*state.text[0])
    field.placeholder = "Type a command or application name"
    field.cursor = state.cursor
    field.anchor = state.anchor
    field.scroll_x = state.scroll_x
    field.focused = state.focused
    field.max_bytes = 255
    field.input.text = TextView(typed[:count])
    field.input.left = key == 263
    field.input.right = key == 262
    field.input.home = key == 268
    field.input.end = key == 269
    field.input.backspace = key == 259
    field.input.delete_forward = key == 261
    field.input.commit = key == 257
    modifiers := KeyboardModifiers(session)
    field.input.shift = (modifiers & KeyModifierShift) != 0
    if (modifiers & KeyModifierControl) != 0 {
        field.input.select_all = key == 65
        field.input.copy = key == 67
        field.input.cut = key == 88
        field.input.paste = key == 86
        field.input.text = ""
    }
    result := TextField(session, field)
    ApplyEdit(state, result.edit)
    state.cursor = result.cursor
    state.anchor = result.anchor
    state.scroll_x = result.scroll_x
    state.focused = result.focused
    text := *state.text[0]
    if result.committed {
        Launch(state, shell, platform, settings, previous, path,
            RillRunMatchLauncher(shell, text, 0), text)
        if state.closed { return }
    }

    y := viewport.y + 86.0
    index: s32 = 0
    while index < 6 && y + 26.0 <= viewport.y + viewport.height - 30.0 {
        match: *RillLauncher
        item: [256]s8
        label: *s8
        if text[0] != 0 {
            match = RillRunMatchLauncher(shell, text, index)
            if match == null { break }
            label = *match.name[0]
        } else {
            if index >= 4 || RillRunHistoryItem(settings, index, *item[0], 256) == 0 { break }
            label = *item[0]
            match = RillRunMatchLauncher(shell, label, 0)
        }
        row: ButtonProps
        row.key = cast(u64)(9900 + index)
        row.bounds = Rectangle.{viewport.x + 8.0, y, viewport.width - 16.0, 26.0}
        row.label = CString(label)
        if match != null { row.label = "" }
        if Button(session, row) > 0 {
            // A recent-row click runs that row's command, even though the
            // command field is empty. The former .kry bridge lost this value.
            Launch(state, shell, platform, settings, previous, path, match, label)
            return
        }
        if match != null {
            Label(session, cast(u64)(10000 + index * 2),
                Rectangle.{viewport.x + 16.0, y + 5.0, 180.0, 20.0}, CString(label), 14)
            Label(session, cast(u64)(10001 + index * 2),
                Rectangle.{viewport.x + 200.0, y + 5.0, viewport.width - 216.0, 20.0},
                CString(*match.description[0]), 12)
        }
        y += 30.0
        index += 1
    }
    if index == 0 {
        hint := "Recent commands appear here"
        if text[0] != 0 { hint = "Press Enter to run the typed command" }
        Label(session, cast(u64)9803,
            Rectangle.{viewport.x + 16.0, viewport.y + 90.0, viewport.width - 32.0, 24.0}, hint, 12)
    }
    if shell.status[0] != 0 {
        Label(session, cast(u64)9804,
            Rectangle.{viewport.x + 16.0, viewport.y + viewport.height - 24.0,
                viewport.width - 32.0, 20.0}, CString(*shell.status[0]), 12)
    }
}
